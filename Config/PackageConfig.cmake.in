include(CMakeFindDependencyMacro)
get_filename_component(_core_sdk_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
find_dependency(SDL3 CONFIG REQUIRED PATHS "${_core_sdk_prefix}/third-party/SDL3" NO_DEFAULT_PATH)
if(UNIX)
    find_dependency(Threads)
endif()

if(WIN32)
    set(_core_sdk_library "${_core_sdk_prefix}/lib/@CORE_TARGET@.lib")
    set(_imgui_sdk_library "${_core_sdk_prefix}/lib/@PROJECT_NAMESPACE@ImGui.lib")
    set(_zstd_sdk_library "${_core_sdk_prefix}/lib/@PROJECT_NAMESPACE@Zstd.lib")
    set(_assimp_sdk_library "${_core_sdk_prefix}/lib/assimp.lib")
    set(_assimp_zlib_sdk_library "${_core_sdk_prefix}/lib/zlibstatic.lib")
    set(_jolt_sdk_library "${_core_sdk_prefix}/lib/Jolt.lib")
    set(_recast_sdk_libraries "${_core_sdk_prefix}/lib/Recast.lib" "${_core_sdk_prefix}/lib/Detour.lib" "${_core_sdk_prefix}/lib/DetourCrowd.lib" "${_core_sdk_prefix}/lib/DetourTileCache.lib")
    set(_miniaudio_sdk_library "${_core_sdk_prefix}/lib/miniaudio.lib")
    set(_coral_sdk_library "${_core_sdk_prefix}/lib/Coral.Native.lib")
    set(_nethost_sdk_library "${_core_sdk_prefix}/lib/nethost.lib")
else()
    set(_core_sdk_library "${_core_sdk_prefix}/lib/lib@CORE_TARGET@.a")
    set(_imgui_sdk_library "${_core_sdk_prefix}/lib/lib@PROJECT_NAMESPACE@ImGui.a")
    set(_zstd_sdk_library "${_core_sdk_prefix}/lib/lib@PROJECT_NAMESPACE@Zstd.a")
    set(_assimp_sdk_library "${_core_sdk_prefix}/lib/libassimp.a")
    set(_assimp_zlib_sdk_library "${_core_sdk_prefix}/lib/libzlibstatic.a")
    set(_jolt_sdk_library "${_core_sdk_prefix}/lib/libJolt.a")
    set(_recast_sdk_libraries "${_core_sdk_prefix}/lib/libRecast.a" "${_core_sdk_prefix}/lib/libDetour.a" "${_core_sdk_prefix}/lib/libDetourCrowd.a" "${_core_sdk_prefix}/lib/libDetourTileCache.a")
    set(_miniaudio_sdk_library "${_core_sdk_prefix}/lib/libminiaudio.a")
    set(_coral_sdk_library "${_core_sdk_prefix}/lib/libCoral.Native.a")
    set(_nethost_sdk_library "${_core_sdk_prefix}/lib/libnethost.a")
endif()

if(NOT TARGET @PROJECT_NAMESPACE@::Core)
    add_library(@PROJECT_NAMESPACE@::Core STATIC IMPORTED)
    set_target_properties(@PROJECT_NAMESPACE@::Core PROPERTIES
        IMPORTED_LOCATION "${_core_sdk_library}"
        INTERFACE_COMPILE_DEFINITIONS KEIRE_STATIC
        INTERFACE_COMPILE_FEATURES cxx_std_20
        INTERFACE_INCLUDE_DIRECTORIES "${_core_sdk_prefix}/include"
    )
    if(MSVC)
        set_property(TARGET @PROJECT_NAMESPACE@::Core APPEND PROPERTY
            INTERFACE_COMPILE_OPTIONS /utf-8 /permissive- /Zc:__cplusplus)
    endif()
    if("@PACKAGE_CONFIGURATION@" STREQUAL "Dist")
        if(MSVC)
            set_property(TARGET @PROJECT_NAMESPACE@::Core APPEND PROPERTY INTERFACE_LINK_OPTIONS /LTCG)
        else()
            set_property(TARGET @PROJECT_NAMESPACE@::Core APPEND PROPERTY INTERFACE_LINK_OPTIONS -flto)
        endif()
    endif()
    if(UNIX)
        set_property(TARGET @PROJECT_NAMESPACE@::Core APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES Threads::Threads)
    endif()
    set_property(TARGET @PROJECT_NAMESPACE@::Core APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES "${_imgui_sdk_library}" "${_zstd_sdk_library}" "${_assimp_sdk_library}" "${_assimp_zlib_sdk_library}" "${_jolt_sdk_library}" "${_recast_sdk_libraries}" "${_miniaudio_sdk_library}" "${_coral_sdk_library}" "${_nethost_sdk_library}" SDL3::SDL3-static)
endif()

include(CMakeParseArguments)

function(keire_define_source_module_pack target)
    set(options)
    set(one_value_args)
    set(multi_value_args SOURCES INCLUDE_DIRECTORIES)
    cmake_parse_arguments(KEIRE_MODULE "${options}" "${one_value_args}" "${multi_value_args}" ${ARGN})
    if(NOT target OR NOT KEIRE_MODULE_SOURCES)
        message(FATAL_ERROR "keire_define_source_module_pack requires a target and SOURCES.")
    endif()
    add_library(${target} STATIC ${KEIRE_MODULE_SOURCES})
    target_link_libraries(${target} PUBLIC @PROJECT_NAMESPACE@::Core)
    target_compile_features(${target} PUBLIC cxx_std_20)
    if(KEIRE_MODULE_INCLUDE_DIRECTORIES)
        target_include_directories(${target} PUBLIC ${KEIRE_MODULE_INCLUDE_DIRECTORIES})
    endif()
endfunction()

function(keire_link_source_module_pack host pack)
    if(NOT TARGET ${host} OR NOT TARGET ${pack})
        message(FATAL_ERROR "keire_link_source_module_pack requires existing host and pack targets.")
    endif()
    target_link_libraries(${host} PRIVATE ${pack})
endfunction()

unset(_nethost_sdk_library)
unset(_coral_sdk_library)
unset(_miniaudio_sdk_library)
unset(_recast_sdk_libraries)
unset(_jolt_sdk_library)
unset(_zstd_sdk_library)
unset(_assimp_zlib_sdk_library)
unset(_assimp_sdk_library)
unset(_imgui_sdk_library)
unset(_core_sdk_library)
unset(_core_sdk_prefix)
