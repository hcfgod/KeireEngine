include(CMakeFindDependencyMacro)
get_filename_component(_core_sdk_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
find_dependency(SDL3 CONFIG REQUIRED PATHS "${_core_sdk_prefix}/third-party/SDL3" NO_DEFAULT_PATH)
if(UNIX)
    find_dependency(Threads)
endif()

if(WIN32)
    set(_core_sdk_library "${_core_sdk_prefix}/lib/@CORE_TARGET@.lib")
    set(_imgui_sdk_library "${_core_sdk_prefix}/lib/@PROJECT_NAMESPACE@ImGui.lib")
    set(_zstd_sdk_library "${_core_sdk_prefix}/lib/@PROJECT_NAMESPACE@Zstd.lib")
else()
    set(_core_sdk_library "${_core_sdk_prefix}/lib/lib@CORE_TARGET@.a")
    set(_imgui_sdk_library "${_core_sdk_prefix}/lib/lib@PROJECT_NAMESPACE@ImGui.a")
    set(_zstd_sdk_library "${_core_sdk_prefix}/lib/lib@PROJECT_NAMESPACE@Zstd.a")
endif()

if(NOT TARGET @PROJECT_NAMESPACE@::Core)
    add_library(@PROJECT_NAMESPACE@::Core STATIC IMPORTED)
    set_target_properties(@PROJECT_NAMESPACE@::Core PROPERTIES
        IMPORTED_LOCATION "${_core_sdk_library}"
        INTERFACE_COMPILE_DEFINITIONS KEIRE_STATIC
        INTERFACE_COMPILE_FEATURES cxx_std_20
        INTERFACE_INCLUDE_DIRECTORIES "${_core_sdk_prefix}/include;${_core_sdk_prefix}/third-party"
    )
    if(MSVC)
        set_property(TARGET @PROJECT_NAMESPACE@::Core APPEND PROPERTY
            INTERFACE_COMPILE_OPTIONS /utf-8 /permissive- /Zc:__cplusplus)
    endif()
    if("@PACKAGE_CONFIGURATION@" STREQUAL "Dist")
        if(MSVC)
            set_property(TARGET @PROJECT_NAMESPACE@::Core APPEND PROPERTY INTERFACE_LINK_OPTIONS /LTCG)
        else()
            set_property(TARGET @PROJECT_NAMESPACE@::Core APPEND PROPERTY INTERFACE_LINK_OPTIONS -flto)
        endif()
    endif()
    if(UNIX)
        set_property(TARGET @PROJECT_NAMESPACE@::Core APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES Threads::Threads)
    endif()
    set_property(TARGET @PROJECT_NAMESPACE@::Core APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES "${_imgui_sdk_library}" "${_zstd_sdk_library}" SDL3::SDL3-static)
endif()

unset(_zstd_sdk_library)
unset(_imgui_sdk_library)
unset(_core_sdk_library)
unset(_core_sdk_prefix)
