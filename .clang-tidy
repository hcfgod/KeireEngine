Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  -performance-enum-size,
  portability-*,
  -portability-avoid-pragma-once,
  modernize-use-nullptr,
  modernize-use-override,
  readability-redundant-*
WarningsAsErrors: '*'
HeaderFilterRegex: '^(KeireCore|KeireClient|KeireTests)/'
FormatStyle: file
CheckOptions:
  bugprone-exception-escape.CheckDestructors: 'false'
  bugprone-exception-escape.CheckMoveMemberFunctions: 'false'
