+void FBXConverter::BuildModelNames() {
+    std::vector<std::pair<const Model *, std::string>> models;
+    std::map<std::string, size_t> baseNameCounts;
+    for (const ObjectMap::value_type &entry : doc.Objects()) {
+        const Token &key = entry.second->GetElement().KeyToken();
+        if (static_cast<size_t>(key.end() - key.begin()) != 5 || strncmp(key.begin(), "Model", 5) != 0) {
+            continue;
+        }
+        const Object *object = entry.second->Get();
+        const Model *model = dynamic_cast<const Model *>(object);
+        if (!model) {
+            continue;
+        }
+
+        std::string baseName = FixNodeName(model->Name());
+        if (baseName.empty()) {
+            baseName = "Model";
+        }
+        models.emplace_back(model, std::move(baseName));
+        ++baseNameCounts[models.back().second];
+    }
+
+    std::sort(models.begin(), models.end(), [](const auto &left, const auto &right) {
+        return left.first->ID() < right.first->ID();
+    });
+
+    std::unordered_set<std::string> usedNames;
+    for (const auto &[model, baseName] : models) {
+        if (baseNameCounts.at(baseName) == 1) {
+            mModelNames.emplace(model->ID(), baseName);
+            usedNames.insert(baseName);
+        }
+    }
+    for (const auto &[model, baseName] : models) {
+        if (baseNameCounts.at(baseName) == 1) {
+            continue;
+        }
+
+        std::string uniqueName = baseName + "_FBX_" + std::to_string(model->ID());
+        while (!usedNames.insert(uniqueName).second) {
+            uniqueName += '_';
+        }
+        mModelNames.emplace(model->ID(), std::move(uniqueName));
+    }
+    for (const auto &[id, name] : mModelNames) {
+        (void)id;
+        mNodeNames.emplace(name, 0);
+    }
+}
+
+const std::string &FBXConverter::ModelName(const Model &model) const {
+    const auto found = mModelNames.find(model.ID());
+    if (found == mModelNames.end()) {
+        throw DeadlyImportError("FBX model identity was not registered before scene conversion");
+    }
+    return found->second;
+}
