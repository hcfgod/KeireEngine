+/* Keire-maintained GPU timestamp extension. */
+struct SDL_GPUTimestampQuery
+{
+    SDL_GPUDevice *device;
+    void *native;
+    Uint32 written;
+};
+
+bool SDL_GPUSupportsTimestampQueries(SDL_GPUDevice *device)
+{
+    CHECK_DEVICE_MAGIC(device, false);
+    return device->SupportsTimestampQueries && device->SupportsTimestampQueries(device->driverData);
+}
+
+SDL_GPUTimestampQuery *SDL_CreateGPUTimestampQuery(SDL_GPUDevice *device)
+{
+    SDL_GPUTimestampQuery *query;
+    if (!SDL_GPUSupportsTimestampQueries(device)) {
+        SDL_SetError("GPU timestamps are unsupported on this device");
+        return NULL;
+    }
+    query = SDL_calloc(1, sizeof(*query));
+    if (!query) {
+        SDL_OutOfMemory();
+        return NULL;
+    }
+    query->device = device;
+    query->native = device->CreateTimestampQuery(device->driverData);
+    if (!query->native) {
+        SDL_free(query);
+        return NULL;
+    }
+    return query;
+}
+
+bool SDL_WriteGPUTimestamp(SDL_GPUCommandBuffer *command_buffer, SDL_GPUTimestampQuery *query, Uint32 index)
+{
+    CommandBufferCommonHeader *header = (CommandBufferCommonHeader *)command_buffer;
+    if (!header || !query || index > 1 || query->device != header->device) {
+        return SDL_SetError("Invalid timestamp query, device, or slot");
+    }
+    if (header->device->debug_mode && (header->submitted || header->render_pass.in_progress || header->compute_pass.in_progress || header->copy_pass.in_progress)) {
+        return SDL_SetError("Timestamps require a recording command buffer outside passes");
+    }
+    if (index == 1 && query->written != 1) {
+        return SDL_SetError("Timestamp slot 0 must precede slot 1");
+    }
+    if (!header->device->WriteTimestamp(command_buffer, query->native, index)) {
+        return false;
+    }
+    query->written = index + 1;
+    return true;
+}
+
+bool SDL_GetGPUTimestampQueryResult(SDL_GPUDevice *device, SDL_GPUTimestampQuery *query, SDL_GPUFence *completion_fence, double *milliseconds)
+{
+    CHECK_DEVICE_MAGIC(device, false);
+    if (!query || query->device != device || !completion_fence || !milliseconds || query->written != 2) {
+        return SDL_SetError("Invalid timestamp result request");
+    }
+    if (!device->QueryFence(device->driverData, completion_fence)) {
+        return false;
+    }
+    return device->GetTimestampQueryResult(device->driverData, query->native, milliseconds);
+}
+
+void SDL_ReleaseGPUTimestampQuery(SDL_GPUDevice *device, SDL_GPUTimestampQuery *query)
+{
+    if (!query) {
+        return;
+    }
+    if (!device || query->device != device) {
+        SDL_SetError("Timestamp query belongs to another device");
+        return;
+    }
+    device->ReleaseTimestampQuery(device->driverData, query->native);
+    SDL_free(query);
+}
