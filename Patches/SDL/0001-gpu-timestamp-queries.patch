 }
 
+/* Keire-maintained timestamps. Results are read only after the submission fence. */
+typedef struct VulkanTimestampQuery
+{
+    VkQueryPool pool;
+    Uint32 validBits;
+    double period;
+} VulkanTimestampQuery;
+
+static Uint32 VULKAN_INTERNAL_TimestampBits(VulkanRenderer *renderer)
+{
+    Uint32 count = 0, bits = 0;
+    VkQueueFamilyProperties *families;
+    renderer->vkGetPhysicalDeviceQueueFamilyProperties(renderer->physicalDevice, &count, NULL);
+    families = SDL_calloc(count, sizeof(*families));
+    if (!families) return 0;
+    renderer->vkGetPhysicalDeviceQueueFamilyProperties(renderer->physicalDevice, &count, families);
+    if (renderer->queueFamilyIndex < count) bits = families[renderer->queueFamilyIndex].timestampValidBits;
+    SDL_free(families);
+    return bits;
+}
+
+static bool VULKAN_SupportsTimestampQueries(SDL_GPURenderer *driverData)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    return VULKAN_INTERNAL_TimestampBits(renderer) != 0 && renderer->physicalDeviceProperties.properties.limits.timestampPeriod > 0;
+}
+
+static void *VULKAN_CreateTimestampQuery(SDL_GPURenderer *driverData)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    VulkanTimestampQuery *query = SDL_calloc(1, sizeof(*query));
+    VkQueryPoolCreateInfo info = {0};
+    VkResult result;
+    if (!query) { SDL_OutOfMemory(); return NULL; }
+    query->validBits = VULKAN_INTERNAL_TimestampBits(renderer);
+    query->period = renderer->physicalDeviceProperties.properties.limits.timestampPeriod;
+    info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+    info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    info.queryCount = 2;
+    result = renderer->vkCreateQueryPool(renderer->logicalDevice, &info, NULL, &query->pool);
+    if (result != VK_SUCCESS) {
+        SDL_SetError("Create GPU timestamp query failed: %d", result);
+        SDL_free(query);
+        return NULL;
+    }
+    return query;
+}
+
+static bool VULKAN_WriteTimestamp(SDL_GPUCommandBuffer *commands, void *opaque, Uint32 index)
+{
+    VulkanCommandBuffer *buffer = (VulkanCommandBuffer *)commands;
+    VulkanRenderer *renderer = buffer->renderer;
+    VulkanTimestampQuery *query = opaque;
+    if (index == 0) renderer->vkCmdResetQueryPool(buffer->commandBuffer, query->pool, 0, 2);
+    renderer->vkCmdWriteTimestamp(buffer->commandBuffer,
+        index == 0 ? VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT : VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, query->pool, index);
+    return true;
+}
+
+static bool VULKAN_GetTimestampQueryResult(SDL_GPURenderer *driverData, void *opaque, double *milliseconds)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    VulkanTimestampQuery *query = opaque;
+    Uint64 values[2];
+    Uint64 mask = query->validBits >= 64 ? SDL_MAX_UINT64 : ((SDL_UINT64_C(1) << query->validBits) - 1);
+    VkResult result = renderer->vkGetQueryPoolResults(renderer->logicalDevice, query->pool, 0, 2,
+        sizeof(values), values, sizeof(Uint64), VK_QUERY_RESULT_64_BIT);
+    if (result != VK_SUCCESS) return SDL_SetError("Read GPU timestamp query failed: %d", result);
+    *milliseconds = (double)((values[1] - values[0]) & mask) * query->period / 1000000.0;
+    return true;
+}
+
+static void VULKAN_ReleaseTimestampQuery(SDL_GPURenderer *driverData, void *opaque)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    VulkanTimestampQuery *query = opaque;
+    renderer->vkDestroyQueryPool(renderer->logicalDevice, query->pool, NULL);
+    SDL_free(query);
+}
+
 static SDL_PropertiesID VULKAN_GetDeviceProperties(
     SDL_GPUDevice *device)
 {
