+/* Keire-maintained timestamp queries. Lifetime is bounded by the caller's submission fence. */
+typedef struct D3D12TimestampQuery
+{
+    ID3D12QueryHeap *heap;
+    ID3D12Resource *readback;
+    UINT64 frequency;
+} D3D12TimestampQuery;
+
+static bool D3D12_SupportsTimestampQueries(SDL_GPURenderer *driverData)
+{
+    D3D12Renderer *renderer = (D3D12Renderer *)driverData;
+    UINT64 frequency = 0;
+    return SUCCEEDED(ID3D12CommandQueue_GetTimestampFrequency(renderer->commandQueue, &frequency)) && frequency != 0;
+}
+
+static void D3D12_ReleaseTimestampQuery(SDL_GPURenderer *driverData, void *opaque)
+{
+    D3D12TimestampQuery *query = opaque;
+    if (query->readback) ID3D12Resource_Release(query->readback);
+    if (query->heap) ID3D12QueryHeap_Release(query->heap);
+    SDL_free(query);
+}
+
+static void *D3D12_CreateTimestampQuery(SDL_GPURenderer *driverData)
+{
+    static const IID queryHeapIID = {0x0d9658ae, 0xed45, 0x469e, {0xa6, 0x1d, 0x97, 0x0e, 0xc5, 0x83, 0xca, 0xb4}};
+    D3D12Renderer *renderer = (D3D12Renderer *)driverData;
+    D3D12TimestampQuery *query = SDL_calloc(1, sizeof(*query));
+    D3D12_QUERY_HEAP_DESC heap = {0};
+    D3D12_HEAP_PROPERTIES properties = {0};
+    D3D12_RESOURCE_DESC buffer = {0};
+    HRESULT result;
+    if (!query) { SDL_OutOfMemory(); return NULL; }
+    result = ID3D12CommandQueue_GetTimestampFrequency(renderer->commandQueue, &query->frequency);
+    if (FAILED(result) || !query->frequency) goto fail;
+    heap.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+    heap.Count = 2;
+    result = ID3D12Device_CreateQueryHeap(renderer->device, &heap, D3D_GUID(queryHeapIID), (void **)&query->heap);
+    if (FAILED(result)) goto fail;
+    properties.Type = D3D12_HEAP_TYPE_READBACK;
+    properties.CreationNodeMask = 1;
+    properties.VisibleNodeMask = 1;
+    buffer.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    buffer.Width = 2 * sizeof(UINT64);
+    buffer.Height = 1;
+    buffer.DepthOrArraySize = 1;
+    buffer.MipLevels = 1;
+    buffer.SampleDesc.Count = 1;
+    buffer.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    result = ID3D12Device_CreateCommittedResource(renderer->device, &properties, D3D12_HEAP_FLAG_NONE, &buffer,
+        D3D12_RESOURCE_STATE_COPY_DEST, NULL, D3D_GUID(D3D_IID_ID3D12Resource), (void **)&query->readback);
+    if (FAILED(result)) goto fail;
+    return query;
+fail:
+    D3D12_INTERNAL_SetError(renderer, "Create GPU timestamp query", result);
+    D3D12_ReleaseTimestampQuery(driverData, query);
+    return NULL;
+}
+
+static bool D3D12_WriteTimestamp(SDL_GPUCommandBuffer *commands, void *opaque, Uint32 index)
+{
+    D3D12CommandBuffer *buffer = (D3D12CommandBuffer *)commands;
+    D3D12TimestampQuery *query = opaque;
+    ID3D12GraphicsCommandList_EndQuery(buffer->graphicsCommandList, query->heap, D3D12_QUERY_TYPE_TIMESTAMP, index);
+    if (index == 1) {
+        ID3D12GraphicsCommandList_ResolveQueryData(buffer->graphicsCommandList, query->heap, D3D12_QUERY_TYPE_TIMESTAMP,
+            0, 2, query->readback, 0);
+    }
+    return true;
+}
+
+static bool D3D12_GetTimestampQueryResult(SDL_GPURenderer *driverData, void *opaque, double *milliseconds)
+{
+    D3D12TimestampQuery *query = opaque;
+    const UINT64 *values = NULL;
+    D3D12_RANGE read = {0, 2 * sizeof(UINT64)};
+    D3D12_RANGE written = {0, 0};
+    UINT64 elapsed;
+    HRESULT result = ID3D12Resource_Map(query->readback, 0, &read, (void **)&values);
+    if (FAILED(result)) {
+        D3D12_INTERNAL_SetError((D3D12Renderer *)driverData, "Map GPU timestamps", result);
+        return false;
+    }
+    elapsed = values[1] - values[0];
+    ID3D12Resource_Unmap(query->readback, 0, &written);
+    *milliseconds = (double)elapsed * 1000.0 / (double)query->frequency;
+    return true;
+}
+
