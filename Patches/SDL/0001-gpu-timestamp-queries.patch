+/* Keire-maintained timestamps, optional on devices without blit-boundary sampling. */
+typedef struct MetalTimestampQuery
+{
+    id<MTLCounterSampleBuffer> samples;
+    MTLTimestamp cpuStart;
+    MTLTimestamp gpuStart;
+} MetalTimestampQuery;
+
+static bool METAL_SupportsTimestampQueries(SDL_GPURenderer *driverData)
+{
+    @autoreleasepool {
+        if (@available(macOS 11.0, iOS 14.0, tvOS 14.0, *)) {
+            MetalRenderer *renderer = (MetalRenderer *)driverData;
+            if (![renderer->device supportsCounterSampling:MTLCounterSamplingPointAtBlitBoundary]) return false;
+            for (id<MTLCounterSet> set in renderer->device.counterSets) {
+                if ([set.name isEqualToString:MTLCommonCounterSetTimestamp]) return true;
+            }
+        }
+        return false;
+    }
+}
+
+static void *METAL_CreateTimestampQuery(SDL_GPURenderer *driverData)
+{
+    @autoreleasepool {
+        if (@available(macOS 11.0, iOS 14.0, tvOS 14.0, *)) {
+            MetalRenderer *renderer = (MetalRenderer *)driverData;
+            MTLCounterSampleBufferDescriptor *descriptor = [MTLCounterSampleBufferDescriptor new];
+            for (id<MTLCounterSet> set in renderer->device.counterSets) {
+                if ([set.name isEqualToString:MTLCommonCounterSetTimestamp]) descriptor.counterSet = set;
+            }
+            descriptor.storageMode = MTLStorageModeShared;
+            descriptor.sampleCount = 2;
+            MetalTimestampQuery *query = SDL_calloc(1, sizeof(*query));
+            if (!query) { SDL_OutOfMemory(); return NULL; }
+            NSError *error = nil;
+            query->samples = [renderer->device newCounterSampleBufferWithDescriptor:descriptor error:&error];
+            if (!query->samples) {
+                SDL_SetError("Create GPU timestamp query: %s", error ? error.localizedDescription.UTF8String : "unsupported");
+                SDL_free(query);
+                return NULL;
+            }
+            return query;
+        }
+        SDL_SetError("GPU timestamp counters require a supported Metal device");
+        return NULL;
+    }
+}
+
+static bool METAL_WriteTimestamp(SDL_GPUCommandBuffer *commands, void *opaque, Uint32 index)
+{
+    @autoreleasepool {
+        if (@available(macOS 11.0, iOS 14.0, tvOS 14.0, *)) {
+            MetalCommandBuffer *buffer = (MetalCommandBuffer *)commands;
+            MetalTimestampQuery *query = opaque;
+            if (index == 0) [buffer->renderer->device sampleTimestamps:&query->cpuStart gpuTimestamp:&query->gpuStart];
+            id<MTLBlitCommandEncoder> encoder = [buffer->handle blitCommandEncoder];
+            if (!encoder) return SDL_SetError("Create timestamp sampling encoder failed");
+            [encoder sampleCountersInBuffer:query->samples atSampleIndex:index withBarrier:YES];
+            [encoder endEncoding];
+            return true;
+        }
+        return false;
+    }
+}
+
+static bool METAL_GetTimestampQueryResult(SDL_GPURenderer *driverData, void *opaque, double *milliseconds)
+{
+    @autoreleasepool {
+        if (@available(macOS 11.0, iOS 14.0, tvOS 14.0, *)) {
+            MetalRenderer *renderer = (MetalRenderer *)driverData;
+            MetalTimestampQuery *query = opaque;
+            MTLTimestamp cpuEnd = 0, gpuEnd = 0;
+            NSData *data = [query->samples resolveCounterRange:NSMakeRange(0, 2)];
+            if (data.length < 2 * sizeof(MTLCounterResultTimestamp)) return SDL_SetError("GPU timestamps unavailable");
+            const MTLCounterResultTimestamp *samples = data.bytes;
+            [renderer->device sampleTimestamps:&cpuEnd gpuTimestamp:&gpuEnd];
+            if (gpuEnd <= query->gpuStart || cpuEnd <= query->cpuStart || samples[1].timestamp < samples[0].timestamp ||
+                samples[0].timestamp < query->gpuStart || samples[1].timestamp > gpuEnd ||
+                samples[0].timestamp == MTLCounterErrorValue || samples[1].timestamp == MTLCounterErrorValue) {
+                return SDL_SetError("Invalid GPU timestamp calibration or samples");
+            }
+            /* Apple's sampleTimestamps CPU clock is nanoseconds; calibrate the GPU clock before converting. */
+            *milliseconds = (double)(samples[1].timestamp - samples[0].timestamp) /
+                (double)(gpuEnd - query->gpuStart) * (double)(cpuEnd - query->cpuStart) / 1000000.0;
+            return true;
+        }
+        return false;
+    }
+}
+
+static void METAL_ReleaseTimestampQuery(SDL_GPURenderer *driverData, void *opaque)
+{
+    MetalTimestampQuery *query = opaque;
+    query->samples = nil;
+    SDL_free(query);
+}
