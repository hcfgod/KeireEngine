@keire-style 1;

.starter-hud {
  width: 100%;
  height: 100%;
  padding: 40px;
  flex-direction: column;
  align-items: start;
  justify-content: end;
}

.starter-card {
  width: 420px;
  padding: 20px;
  gap: 8px;
  flex-direction: column;
  background-color: #101827e8;
  border-color: #4f6580ff;
  border-width: 1px;
  border-radius: 14px;
}

.starter-title {
  height: 36px;
  color: #f3f8ffff;
  font-size: 26px;
}

.starter-copy { height: 26px; color: #a7bdd8ff; font-size: 16px; }
.starter-actions { height: 48px; gap: 8px; flex-direction: row; }
Button.primary { width: 180px; height: 48px; background-color: #245f9eff; color: #ffffffff; border-radius: 8px; }
Button.primary:hover { background-color: #3384d6ff; }

.starter-render-target {
  width: 1024px;
  height: 1024px;
  padding: 72px;
  gap: 24px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #102a46ff;
  border-color: #67a7ffff;
  border-width: 12px;
  border-radius: 48px;
}

.starter-render-preview {
  width: 320px;
  height: 160px;
  border-color: #67a7ffff;
  border-width: 3px;
  border-radius: 12px;
}
