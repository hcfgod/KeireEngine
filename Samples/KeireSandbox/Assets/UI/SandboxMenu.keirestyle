@keire-style 1;

.screen {
  width: 100%;
  height: 100%;
  padding: 36px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.menu-card {
  width: 520px;
  padding: 36px;
  gap: 18px;
  flex-direction: column;
  align-items: center;
  background-color: #07111ff5;
  border-color: #3e8effff;
  border-width: 2px;
  border-radius: 18px;
}

.title {
  width: 448px;
  height: 52px;
  color: #dbefffff;
  font-size: 34px;
}

.subtitle {
  width: 448px;
  height: 30px;
  color: #54c7f2ff;
  font-size: 16px;
}

Button.primary {
  width: 250px;
  height: 48px;
  background-color: #1473b8ff;
  color: #ffffffff;
  border-radius: 10px;
}

Button.primary:hover {
  background-color: #1f99e6ff;
}
