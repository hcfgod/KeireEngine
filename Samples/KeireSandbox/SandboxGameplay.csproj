<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0168;CS0169;CS0219;CS0414</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CS0649;CS8601;CS8618</NoWarn>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>SandboxGameplay</AssemblyName>
    <RootNamespace>KeireSandbox</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Assets/Scripts/Runtime/**/*.cs" LinkBase="Assets/Scripts/Runtime" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Library/ScriptAssemblies/References/Keire.Managed.VisualStudio.csproj" />
  </ItemGroup>
</Project>
