[Unit]
Description=Kéire Web Platform
After=network-online.target keire-distribution.service
Wants=network-online.target

[Service]
Type=exec
User=keire-web
Group=keire-web
WorkingDirectory=/opt/keire-distribution/Web
ExecStart=/usr/bin/node /opt/keire-distribution/Web/dist/server/entry.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4321
Environment=KEIRE_DISTRIBUTION_HEALTH_URL=http://127.0.0.1:5088/health/ready
EnvironmentFile=-/etc/keire/web.env
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/keire-distribution/Web
ReadWritePaths=/var/lib/keire-web /var/log/keire-web

[Install]
WantedBy=multi-user.target
