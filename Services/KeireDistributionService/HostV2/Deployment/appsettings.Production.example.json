{
  "Distribution": {
    "StorageRoot": "/srv/keire-distribution",
    "BindUrl": "http://127.0.0.1:5088",
    "SnapshotPollSeconds": 2,
    "MaximumSnapshotFiles": 100000,
    "MaximumManifestBytes": 8388608,
    "MaximumDocumentBytes": 33554432,
    "MetadataRequestsPerMinute": 120,
    "PackageConcurrentStreams": 16,
    "PackageQueueLimit": 32,
    "StreamBufferBytes": 131072
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
