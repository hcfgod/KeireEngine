<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <AssemblyName>KeireDistributionPublisher</AssemblyName>
    <RootNamespace>Keire.Distribution.Publisher</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="libsodium" Version="1.0.22" />
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <ProjectReference Include="../KeireDistribution.Contracts/KeireDistribution.Contracts.csproj" />
  </ItemGroup>
</Project>
