<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>KeireMarketplaceValidatorBroker</AssemblyName>
    <RootNamespace>Keire.Marketplace.Validator.Broker</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KeireDistribution.Contracts/KeireDistribution.Contracts.csproj" />
    <ProjectReference Include="../KeireMarketplace.Validation/KeireMarketplace.Validation.csproj" />
    <ProjectReference Include="../KeireMarketplace.Security/KeireMarketplace.Security.csproj" />
  </ItemGroup>
</Project>
