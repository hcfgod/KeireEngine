# Install as /etc/keire/marketplace-publication-signer.env, owned by root:keire-publication, mode 0640.
# The scoped queue secret is shared only with the marketplace-publication-queue Edge Function.
KEIRE_SUPABASE_URL=https://your-project-ref.supabase.co
KEIRE_MARKETPLACE_PUBLICATION_SIGNER_SECRET=replace-with-at-least-32-random-characters
KEIRE_MARKETPLACE_PUBLICATION_PRIVATE_KEY=replace-with-canonical-base64-pkcs8-private-key
KEIRE_MARKETPLACE_PUBLICATION_PUBLIC_KEY=/etc/keire/keys/marketplace-publication-public.json
KEIRE_VALIDATOR_ATTESTATION_PUBLIC_KEY=/etc/keire/keys/marketplace-validator-attestation-public.json
KEIRE_MARKETPLACE_PUBLICATION_WORKER_ID=publication-production-01
KEIRE_MARKETPLACE_PUBLICATION_LEASE_SECONDS=300
KEIRE_MARKETPLACE_PUBLICATION_IDLE_POLL_MS=5000
