# Install as /etc/keire/marketplace-validator-broker.env, owned by root:keire-validator-broker, mode 0640.
# Set a dedicated random validator broker secret; use the same value only in the Edge Function secret store.
KEIRE_SUPABASE_URL=https://your-project-ref.supabase.co
KEIRE_VALIDATOR_BROKER_SECRET=replace-with-at-least-32-random-characters
KEIRE_VALIDATOR_EXPECTED_FINGERPRINT_SHA256=replace-with-worker-binary-sha256
KEIRE_VALIDATOR_EXCHANGE_ROOT=/var/lib/keire-marketplace-validator/exchange
KEIRE_VALIDATOR_WORKER_ID=validator-production-01
KEIRE_VALIDATOR_LEASE_SECONDS=900
KEIRE_VALIDATOR_IDLE_POLL_MS=5000
KEIRE_VALIDATOR_REPORT_POLL_MS=500
KEIRE_VALIDATOR_JOB_TIMEOUT_SECONDS=1800
