{
	admin {$KEIRE_CADDY_ADMIN:localhost:2019}
	http_port {$KEIRE_CADDY_HTTP_PORT:80}
	https_port {$KEIRE_CADDY_HTTPS_PORT:443}
}

{$KEIRE_DISTRIBUTION_HOST:distribution.example.invalid} {
	@compressible {
		not path /preview-downloads/*
	}
	encode @compressible zstd gzip
	root * "{$KEIRE_WEBSITE_ROOT:Website}"

	@unsupported_method not method GET HEAD
	respond @unsupported_method 405

	@distribution_api path /v1 /v1/* /health /health/*
	handle @distribution_api {
		reverse_proxy 127.0.0.1:5088
	}

	handle_path /preview-downloads/* {
		root * "{$KEIRE_PREVIEW_DOWNLOAD_ROOT:PreviewDownloads}"
		header Cache-Control "public, max-age=31536000, immutable"
		header Content-Disposition "attachment"
		file_server
	}

	@static_assets path /assets/*
	header @static_assets Cache-Control "public, max-age=86400, must-revalidate"

	@site_documents path / /index.html /features/* /docs/* /downloads/* /roadmap/* /contact/* /privacy/* /404.html
	header @site_documents Cache-Control "no-cache"

	handle {
		try_files {path} {path}/index.html
		file_server
	}

	handle_errors {
		@not_found expression {http.error.status_code} == 404
		rewrite @not_found /404.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://khjduyjamzwumhducmou.supabase.co; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'; upgrade-insecure-requests"
		-Server
	}

	log {
		output file "{$KEIRE_CADDY_LOG:logs/distribution-access.json}" {
			roll_size 100MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}
