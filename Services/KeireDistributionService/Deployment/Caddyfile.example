{
	admin {$KEIRE_CADDY_ADMIN:localhost:2019}
	http_port {$KEIRE_CADDY_HTTP_PORT:80}
	https_port {$KEIRE_CADDY_HTTPS_PORT:443}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://khjduyjamzwumhducmou.supabase.co; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https://khjduyjamzwumhducmou.supabase.co; media-src 'self' https://khjduyjamzwumhducmou.supabase.co; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests"
		-Server
	}
}

{$KEIRE_DISTRIBUTION_HOST:distribution.example.invalid} {
	@compressible {
		not path /preview-downloads/*
	}
	encode @compressible zstd gzip
	request_body {
		max_size 2MB
	}

	@distribution_api path /v1 /v1/* /v2 /v2/* /health/live /health/ready
	handle @distribution_api {
		reverse_proxy 127.0.0.1:5088
	}

	@preview_unsupported {
		path /preview-downloads/*
		not method GET HEAD
	}
	respond @preview_unsupported 405

	handle_path /preview-downloads/* {
		root * "{$KEIRE_PREVIEW_DOWNLOAD_ROOT:PreviewDownloads}"
		header Cache-Control "public, max-age=31536000, immutable"
		header Content-Disposition "attachment"
		file_server
	}

	@immutable_web_assets path /_astro/* /docs/_astro/*
	header @immutable_web_assets Cache-Control "public, max-age=31536000, immutable"

	@search_assets path /pagefind/* /docs/pagefind/*
	header @search_assets Cache-Control "public, max-age=86400, must-revalidate"

	handle {
		reverse_proxy 127.0.0.1:4321 {
			health_uri /health/
			health_status 2xx
		}
	}

	import security_headers

	log {
		output file "{$KEIRE_CADDY_LOG:logs/distribution-access.json}" {
			roll_size 100MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}
