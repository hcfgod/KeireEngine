---
import PlatformLayout from "../../../layouts/PlatformLayout.astro";
export const prerender = true;
---
<PlatformLayout title="Release archive" description="Review retained Kéire Hub releases and their exact platform, version, size, and SHA-256 identities." active="downloads">
    <section class="platform-section"><div class="platform-shell"><div class="section-heading"><div><p class="eyebrow">Auditable history</p><h1>Retained releases without download clutter.</h1></div><p>Use the current supported version unless a project explicitly requires an older Editor. Security-revoked artifacts never appear as downloadable.</p></div><div data-download-history>
        <section class="notice-panel"><h2>Windows</h2><p data-history-state="windows">Checking retained releases…</p><div class="download-variants" data-history-platform="windows"></div></section>
        <section class="notice-panel"><h2>Linux</h2><p data-history-state="linux">Checking retained releases…</p><div class="download-variants" data-history-platform="linux"></div></section>
        <section class="notice-panel"><h2>macOS</h2><p data-history-state="macos">Checking retained releases…</p><div class="download-variants" data-history-platform="macos"></div></section>
    </div></div></section>
</PlatformLayout>
<script src="/assets/downloads.js" defer></script>
