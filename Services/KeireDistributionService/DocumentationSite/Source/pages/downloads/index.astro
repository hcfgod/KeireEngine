---
import PlatformLayout from "../../layouts/PlatformLayout.astro";
import { releaseStatus } from "../../lib/release-status";
export const prerender = true;
---
<PlatformLayout title="Downloads" description="Download Kéire Hub for Windows or Linux. Choose your platform, check release details, and start a project." active="downloads">
    <section class="platform-section platform-shell">
        <div class="section-heading" data-reveal><div><p class="eyebrow">Start with Kéire Hub</p><h1>Your next project<br />starts here.</h1></div><p>Choose your platform. Hub helps you install an Editor, manage your projects, and keep your tools together.</p></div>
        <aside class="notice-panel"><strong>Available packages: {releaseStatus.availableVersion}.</strong> {releaseStatus.preparing ? `Source ${releaseStatus.sourceVersion} is ahead of the available downloads. New packages appear here after validation.` : "Choose a platform below for the latest verified package."}</aside>
        <div class="editorial-grid download-options">
            <article id="windows" class="editorial-panel download-card" data-platform="windows">
                <span class="eyebrow">Windows · x86-64</span><h2>For your Windows PC.</h2><p>Windows 10 or 11. Download the installer, open Hub, and choose an Editor.</p>
                <p class="form-message" data-download-state>Checking available Windows packages…</p><div class="download-variants" data-download-variants></div>
                <details><summary>Installation and signing details</summary><p>The download catalog and package hash are verified. The current EXE is not Authenticode-signed, so Windows may display a publisher warning. Hub 0.4.1 users need to download and run 0.4.2 manually unless a signed bridge build is published.</p></details>
                <a class="text-action" href="/downloads/windows/">Windows release details →</a>
            </article>
            <article id="linux" class="editorial-panel download-card" data-platform="linux">
                <span class="eyebrow">Linux · x86-64</span><h2>At home on Linux.</h2><p>Choose DEB for Ubuntu or Debian, or RPM for Fedora, Rocky Linux, and openSUSE.</p>
                <p class="form-message" data-download-state>Checking available Linux packages…</p><div class="download-variants" data-download-variants></div>
                <details><summary>Platform availability</summary><p>Linux packages are validated independently of Windows. Arch is a source-build target. Check the package version shown above before installing.</p></details>
            </article>
            <article id="macos" class="editorial-panel download-card" data-platform="macos">
                <span class="eyebrow">macOS</span><h2>Still on the way.</h2><p>A native download needs platform validation, signing, and notarization before release.</p>
                <p class="form-message" data-download-state>Checking release status…</p><div class="download-variants" data-download-variants></div>
            </article>
            <article class="editorial-panel"><span class="eyebrow">Earlier releases</span><h2>Looking for a version?</h2><p>Browse earlier release records and package details in the archive.</p><a class="button button--secondary" href="/downloads/archive/">Open release archive →</a></article>
        </div>
        <noscript><p class="notice-panel">Enable JavaScript to check current catalog-verified downloads. You can still <a href="/docs/reference/getting-started/">read the getting-started guide</a>.</p></noscript>
    </section>
</PlatformLayout>
<script src="/assets/downloads.js" defer></script>
