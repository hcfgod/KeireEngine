---
import PlatformLayout from "../layouts/PlatformLayout.astro";

export const prerender = true;

const structuredData = [
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "Kéire Engine",
        url: "https://keireengine.duckdns.org/",
        logo: "https://keireengine.duckdns.org/assets/keire.png",
        sameAs: ["https://github.com/hcfgod/KeireEngine"],
    },
    {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "Kéire Engine",
        applicationCategory: "DeveloperApplication",
        operatingSystem: "Windows, Linux",
        softwareVersion: "0.3.1",
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    },
];
---

<PlatformLayout title="Kéire Engine"
    description="Kéire is an open C++20 game engine with a project-first Hub, deterministic content systems, and production-minded authoring tools."
    structuredData={structuredData}>
    <section class="hero-platform">
        <img class="hero-platform__art" src="/assets/hero-cinematic.png" width="1536" height="1024" alt=""
             fetchpriority="high" decoding="async" />
        <div class="platform-shell">
            <div class="hero-platform__copy" data-reveal>
                <p class="eyebrow">Open game technology · Kéire 0.3.1</p>
                <h1 class="display-title">Build worlds.<br /><span>Own the system.</span></h1>
                <p class="lead">A transparent engine, focused editor, and project-first Hub for developers who want modern workflows without surrendering control of their pipeline.</p>
                <div class="actions">
                    <a class="button" href="/downloads/">Download Kéire Hub</a>
                    <a class="button button--secondary" href="/docs/reference/getting-started/">Start building</a>
                    <a class="button button--quiet" href="https://github.com/hcfgod/KeireEngine">Inspect the source ↗</a>
                </div>
            </div>
            <div class="evidence-strip" aria-label="Current release evidence" data-reveal style="--reveal-index: 2">
                <div><strong>C++20 foundations</strong><span>Explicit ownership and lifecycle</span></div>
                <div><strong>Windows + Linux</strong><span>Validated x86-64 editor targets</span></div>
                <div><strong>Deterministic content</strong><span>Hashed assets and package contracts</span></div>
                <div><strong>MIT licensed</strong><span>Open development, pre-1.0</span></div>
            </div>
        </div>
    </section>

    <section class="platform-section platform-section--line">
        <div class="platform-shell">
            <div class="section-heading" data-reveal>
                <div><p class="eyebrow">One deliberate workflow</p><h2>From a blank project to a validated player.</h2></div>
                <p>Kéire connects installation, authoring, simulation, content cooking, packaging, and diagnosis through boundaries you can inspect and reason about.</p>
            </div>
            <div class="editorial-grid">
                <article class="editorial-panel" data-reveal style="--reveal-index: 1"><span class="editorial-panel__index">01</span><h3>Hub owns projects and toolchains.</h3><p>Keep editor versions independent, resolve compatible components, and observe resumable tasks without mixing engine binaries into project content.</p></article>
                <article class="editorial-panel" data-reveal style="--reveal-index: 2"><span class="editorial-panel__index">02</span><h3>Author with live context.</h3><p>Scenes, shaders, materials, animation, audio, input, C#, and VFX stay connected to diagnostics and recoverable state.</p></article>
                <article class="editorial-panel" data-reveal style="--reveal-index: 3"><span class="editorial-panel__index">03</span><h3>Ship deterministic content.</h3><p>Typed identities, stable manifests, explicit package sources, and bounded archives make release output inspectable.</p></article>
                <article class="editorial-panel" data-reveal style="--reveal-index: 4"><span class="editorial-panel__index">04</span><h3>Keep last-good state.</h3><p>Transactional imports, project recovery journals, compilation diagnostics, and safe upgrades are product behavior—not cleanup work postponed until launch.</p></article>
            </div>
        </div>
    </section>

    <section class="platform-section">
        <div class="platform-shell">
            <div class="section-heading"><div><p class="eyebrow">How work moves</p><h2>Clear owners at every boundary.</h2></div><p>The Hub, Editor, asset pipeline, and runtime collaborate through versioned contracts instead of hidden shared state.</p></div>
            <div class="workflow-line">
                <article><small>01 / Discover</small><h3>Choose the right Editor</h3><p>Hub resolves a verified release and keeps project compatibility visible.</p></article>
                <article><small>02 / Author</small><h3>Build with immediate feedback</h3><p>Focused tools expose validation where the graph, asset, or scene failed.</p></article>
                <article><small>03 / Validate</small><h3>Cook exact inputs</h3><p>Build fingerprints bind assets, scripts, packages, platform, and renderer capability.</p></article>
                <article><small>04 / Recover</small><h3>Fail without corruption</h3><p>Atomic publication and journals preserve the last state known to be valid.</p></article>
            </div>
        </div>
    </section>

    <section class="platform-section platform-section--line">
        <div class="platform-shell cta-band">
            <div><p class="eyebrow">Build in the open</p><h2>Kéire is substantial, early, and honest about both.</h2></div>
            <div class="actions"><a class="button" href="/downloads/">Get Hub 0.3.1</a><a class="button button--secondary" href="/roadmap/">Read the roadmap</a></div>
        </div>
    </section>
</PlatformLayout>
