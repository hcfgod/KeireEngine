---
import PlatformLayout from "../layouts/PlatformLayout.astro";
import ProductMedia from "../components/ProductMedia.astro";
import { productFeatures } from "../lib/product-features";
import { releaseStatus } from "../lib/release-status";
export const prerender = true;
const structuredData = [
    { "@context": "https://schema.org", "@type": "Organization", name: "Kéire Engine",
      url: "https://keireengine.duckdns.org/", logo: "https://keireengine.duckdns.org/assets/keire.png",
      sameAs: ["https://github.com/hcfgod/KeireEngine"] },
    { "@context": "https://schema.org", "@type": "SoftwareApplication", name: "Kéire Engine",
      applicationCategory: "DeveloperApplication", operatingSystem: "Windows, Linux",
      softwareVersion: releaseStatus.availableVersion, offers: { "@type": "Offer", price: "0", priceCurrency: "USD" } },
];
---
<PlatformLayout title="Kéire Engine" description="An open-source game engine for worlds of your own. Explore Kéire’s visual editor, C# scripting, and C++20 foundations. Free and MIT licensed." structuredData={structuredData}>
    <section class="studio-hero">
        <div class="platform-shell studio-hero__grid">
            <div class="studio-hero__copy">
                <a class="release-pill" href="/changelog/"><span class="status-dot"></span> Kéire {releaseStatus.availableVersion} <span>Release notes ↗</span></a>
                <p class="eyebrow">Independent engine. Unlimited curiosity.</p>
                <h1>A world<br />only <em>you</em><br />could make.</h1>
                <p class="lead">Bring your next idea to life. A visual editor, C# gameplay, and an open C++ engine. All yours to explore.</p>
                <div class="actions"><a class="button" href="/downloads/">Download Kéire Hub <span aria-hidden="true">↗</span></a><a class="text-action" href="/features/">Explore the engine →</a></div>
                <p class="hero-footnote">Free &amp; MIT licensed · Windows + Linux · Pre-1.0</p>
            </div>
            <a class="studio-hero__visual" href="/showcase/" aria-label="Explore the Kéire Outpost showcase">
                <ProductMedia name="arrival" alt="The Outpost courtyard, watchtower, aircraft, and vehicle yard rendered in Kéire." priority />
                <span class="image-label">Rendered in Kéire</span>
                <div class="scene-caption"><span><small>A Kéire showcase</small><strong>The Outpost</strong></span><span class="round-arrow" aria-hidden="true">↗</span></div>
            </a>
        </div>
        <div class="platform-shell studio-facts"><span><strong>C++20</strong> Open foundations</span><span><strong>C#</strong> Gameplay scripting</span><span><strong>Visual</strong> Scene &amp; graph editing</span><span><strong>MIT</strong> Yours to build with</span></div>
    </section>
    <section class="platform-section platform-shell">
        <div class="section-heading"><div><p class="eyebrow">One project. Connected tools.</p><h2>From the first object<br />to your next obsession.</h2></div><p>Get to the part you love. Explore the tools for building, shaping, and bringing your world to life.</p></div>
        <div class="feature-cards">{productFeatures.map((feature, index) => <a class="feature-card" href={`/features/${feature.id}/`}>
            <ProductMedia name={feature.image} alt={feature.alt} />
            <div><span class="eyebrow">0{index + 1} / {feature.label}</span><h3>{feature.title}</h3><p>{feature.summary}</p><span class="text-action">Explore the tools <span aria-hidden="true">↗</span></span></div>
        </a>)}</div>
    </section>
    <section class="platform-shell start-band">
        <div><p class="eyebrow">Your starting point</p><h2>Less setup.<br />More making.</h2><p>Kéire Hub keeps your Editors and projects together. Install an Editor, choose a template, and start building.</p><a class="button" href="/downloads/">Get Kéire Hub ↗</a></div>
        <ol class="start-steps">
            <li><span>01</span><div><h3>Install your tools</h3><p>Choose a Windows or Linux package and open Hub.</p></div></li>
            <li><span>02</span><div><h3>Make a project</h3><p>Start with the Sandbox and explore its editable examples.</p></div></li>
            <li><span>03</span><div><h3>Make it your own</h3><p>Build a scene, write a behavior, and press Play.</p><a class="text-action" href="/docs/reference/getting-started/">Follow the getting-started guide →</a></div></li>
        </ol>
    </section>
    <section class="platform-section platform-shell development-strip">
        <div><p class="eyebrow">Built in the open</p><h2>Follow the work.<br />Be part of what’s next.</h2><p>Kéire is independent and pre-1.0. Explore the code, read the current limitations, and help shape the engine.</p></div>
        <div class="resource-links">
            <a href="/roadmap/"><span><strong>The road ahead</strong><small>Current priorities and future direction</small></span><span aria-hidden="true">↗</span></a>
            <a href="/changelog/"><span><strong>What’s new</strong><small>Source {releaseStatus.sourceVersion} · Packages {releaseStatus.availableVersion}</small></span><span aria-hidden="true">↗</span></a>
            <a href="https://github.com/hcfgod/KeireEngine"><span><strong>Make a contribution</strong><small>Source, issues, and development on GitHub</small></span><span aria-hidden="true">↗</span></a>
        </div>
    </section>
</PlatformLayout>
