---
import PlatformLayout from "../layouts/PlatformLayout.astro";
import ProductMedia from "../components/ProductMedia.astro";
import { releaseStatus } from "../lib/release-status";
export const prerender = true;
const structuredData = [
    { "@context": "https://schema.org", "@type": "Organization", name: "Kéire Engine",
      url: "https://keireengine.duckdns.org/", logo: "https://keireengine.duckdns.org/assets/keire.png",
      sameAs: ["https://github.com/hcfgod/KeireEngine"] },
    { "@context": "https://schema.org", "@type": "SoftwareApplication", name: "Kéire Engine",
      applicationCategory: "DeveloperApplication", operatingSystem: "Windows, Linux",
      softwareVersion: releaseStatus.availableVersion, offers: { "@type": "Offer", price: "0", priceCurrency: "USD" } },
];
---
<PlatformLayout title="Kéire Engine" description="Make a world of your own with Kéire: an open-source game engine, visual editor, and C# scripting. Start with Kéire Hub." structuredData={structuredData}>
    <section class="outpost-hero platform-shell">
        <div class="outpost-hero__heading" data-reveal>
            <div><p class="eyebrow"><span class="status-dot"></span> Open source. Yours to build with.</p>
                <h1>Make a world<br />of <em>your own.</em></h1></div>
            <div class="outpost-hero__intro"><p>A scene, a character, an idea you can’t leave alone. Bring it to life with Kéire’s visual editor, C# scripting, and open C++ engine.</p>
                <div class="actions"><a class="button" href="/downloads/">Download Kéire Hub <span aria-hidden="true">↗</span></a><a class="text-action" href="/docs/reference/getting-started/">Get started <span aria-hidden="true">→</span></a></div>
                <p class="hero-footnote">Free &amp; MIT licensed · Windows and Linux · Pre-1.0</p></div>
        </div>
        <a class="outpost-hero__scene" href="/showcase/" aria-label="Explore the Kéire Outpost showcase">
            <ProductMedia name="arrival" alt="A stylized outpost with barracks, a watchtower, and a vehicle yard, rendered in Kéire." priority />
            <div class="scene-caption"><span><small>Built with Kéire</small><strong>The Outpost</strong></span><span class="scene-caption__link">Explore the scene <span aria-hidden="true">↗</span></span></div>
        </a>
        <div class="product-facts"><span>Visual scene editing</span><span>Shader &amp; Material Graphs</span><span>C# gameplay</span><span>Source you can explore</span></div>
    </section>
    <section class="platform-section platform-shell">
        <div class="section-heading" data-reveal><div><p class="eyebrow">From the first idea</p><h2>A little less setup.<br />A lot more making.</h2></div><p>Keep your projects, tools, and creative work connected. Start small, press Play often, and grow from there.</p></div>
        <div class="making-steps">
            <article data-reveal><span>01 / Get ready</span><h3>A home for your projects.</h3><p>Install an Editor, choose a starting point, and open your project from Kéire Hub.</p><a href="/downloads/">Meet Kéire Hub →</a></article>
            <article data-reveal><span>02 / Make it yours</span><h3>Build with the result in view.</h3><p>Arrange a scene, shape a material, and add behavior with C#. Your tools stay close to your work.</p><a href="/features/">Explore the editor →</a></article>
            <article data-reveal><span>03 / Bring it to life</span><h3>Press Play. Keep creating.</h3><p>Try your ideas in the editor, follow the diagnostics, and build a standalone player when you’re ready.</p><a href="/docs/reference/manual/player-builds-and-packages/">Build a player →</a></article>
        </div>
    </section>
    <section class="platform-section platform-section--line">
        <div class="platform-shell"><div class="section-heading" data-reveal><div><p class="eyebrow">Inside the Outpost</p><h2>One small world.<br />Room to experiment.</h2></div><p>The Outpost brings models, materials, lighting, and effects into one Kéire project. Take a closer look at how the scene comes together.</p></div><ProductMedia name="vehicle" alt="The Outpost tank with textured tracks, with the workshop and watchtower behind it." caption="Models, materials, and lighting in the same Kéire scene." /><a class="text-action film-followup" href="/showcase/">Explore the images and tour →</a></div>
    </section>
    <section class="platform-section platform-shell feature-story" data-reveal>
        <ProductMedia name="materials" alt="Material examples in the Outpost workshop." caption="Material experiments, in the same scene." />
        <div><p class="eyebrow">Tools for the details</p><h2>Find the look.<br />Make it move.</h2><p>Build reusable shaders and materials with graphs. Add animation, layer in VFX, and connect the moment to your gameplay code.</p><a class="button button--secondary" href="/features/">Explore the tools ↗</a></div>
    </section>
    <section class="platform-section platform-section--line"><div class="platform-shell open-development" data-reveal>
        <div><p class="eyebrow">An engine you can get to know</p><h2>Made in the open.<br />Still taking shape.</h2></div>
        <div><p>Kéire is an independent, pre-1.0 engine. You can read the code, follow what’s changing, and help make it better. Check the release notes and current limits before choosing it for your project.</p><p class="release-note">Source {releaseStatus.sourceVersion} · Available packages {releaseStatus.availableVersion}</p><div class="actions"><a class="text-action" href="/roadmap/">Follow the roadmap →</a><a class="text-action" href="https://github.com/hcfgod/KeireEngine">Explore the source ↗</a></div></div>
    </div></section>
</PlatformLayout>
