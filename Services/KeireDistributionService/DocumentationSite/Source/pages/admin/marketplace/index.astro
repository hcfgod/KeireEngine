---
import PlatformLayout from "../../../layouts/PlatformLayout.astro";
import ReadinessProgress from "../../../components/ReadinessProgress.astro";
import { mfaChallengePath } from "../../../lib/auth";
import { completedReadinessChecks, launchReadinessTracks, totalReadinessChecks } from "../../../lib/launchReadiness";

export const prerender = false;

const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
let staffRole: "moderator" | "administrator" | null = null;
if (supabase && user) {
    const staffResult = await supabase.from("platform_staff_members")
        .select("role,active").eq("user_id", user.id).eq("active", true).maybeSingle();
    if (staffResult.data?.role === "moderator" || staffResult.data?.role === "administrator") {
        staffRole = staffResult.data.role;
    }
}
const allowed = Boolean(user && staffRole);
if (!allowed) Astro.response.status = 404;
if (allowed && Astro.locals.assurance.currentLevel !== "aal2") {
    return Astro.redirect(mfaChallengePath(Astro.url.pathname), 303);
}

let applications: any[] = [];
let activeSubmissions: any[] = [];
let signingSubmissions: any[] = [];
let submissionHistory: any[] = [];
let reports: any[] = [];
let staff: any[] = [];
let flags: any[] = [];
let audits: any[] = [];
let versions: any[] = [];
let products: any[] = [];
let validationReports: any[] = [];
let publicationJobs: any[] = [];
let officialProducts: any[] = [];
let officialVersions: any[] = [];

if (allowed && supabase) {
    const [applicationResult, activeSubmissionResult, signingSubmissionResult, historyResult, reportResult,
        staffResult, flagResult, auditResult, officialPublisherResult] = await Promise.all([
        supabase.from("publisher_applications")
            .select("id,applicant_user_id,organization_id,public_name,website_url,portfolio_url,statement,state,submitted_at,updated_at")
            .in("state", ["submitted"]).order("submitted_at"),
        supabase.from("marketplace_submissions")
            .select("id,version_id,validation_report_id,submitted_by,state,assigned_to,decision_note,submitted_at,decided_at")
            .in("state", ["submitted", "in_review"])
            .order("submitted_at"),
        supabase.from("marketplace_submissions")
            .select("id,version_id,validation_report_id,submitted_by,state,assigned_to,decision_note,submitted_at,decided_at")
            .eq("state", "approved_pending_signature").order("decided_at"),
        supabase.from("marketplace_submissions")
            .select("id,version_id,validation_report_id,submitted_by,state,assigned_to,decision_note,submitted_at,decided_at")
            .in("state", ["changes_requested", "approved", "rejected", "withdrawn"])
            .order("decided_at", { ascending: false }).limit(20),
        supabase.from("marketplace_reports")
            .select("id,reporter_user_id,product_id,review_id,reason,details,state,assigned_to,resolution_note,created_at")
            .in("state", ["open", "triaged"]).order("created_at"),
        supabase.from("platform_staff_members")
            .select("user_id,role,active,appointed_by,appointed_at,updated_at,revoked_at").order("appointed_at"),
        supabase.from("platform_feature_flags")
            .select("key,enabled,description,updated_at,updated_by").order("key"),
        supabase.from("platform_audit_events")
            .select("id,actor_user_id,action,target_type,target_id,occurred_at,metadata")
            .order("occurred_at", { ascending: false }).limit(30),
        supabase.from("publishers").select("id").eq("slug", "keire-engine").eq("verified", true).maybeSingle(),
    ]);
    applications = applicationResult.data ?? [];
    activeSubmissions = activeSubmissionResult.data ?? [];
    signingSubmissions = signingSubmissionResult.data ?? [];
    submissionHistory = historyResult.data ?? [];
    reports = reportResult.data ?? [];
    staff = staffResult.data ?? [];
    flags = flagResult.data ?? [];
    audits = auditResult.data ?? [];

    const submissions = [...activeSubmissions, ...signingSubmissions, ...submissionHistory];
    const versionIds = submissions.map((submission: any) => submission.version_id);
    const reportIds = submissions.map((submission: any) => submission.validation_report_id);
    if (versionIds.length) {
        const [versionResult, publicationJobResult] = await Promise.all([
            supabase.from("marketplace_product_versions")
                .select("id,product_id,version,state,install_kind,platforms,architectures,archive_sha256,archive_size_bytes,manifest_sha256,validator_version,updated_at")
                .in("id", versionIds),
            supabase.from("marketplace_publication_jobs")
                .select("id,version_id,state,attempt_count,last_error_code,created_at,updated_at,published_at")
                .in("version_id", versionIds),
        ]);
        versions = versionResult.data ?? [];
        publicationJobs = publicationJobResult.data ?? [];
    }
    const productIds = versions.map((version: any) => version.product_id);
    if (productIds.length) {
        const productResult = await supabase.from("marketplace_products")
            .select("id,publisher_id,slug,display_name,state,license_spdx,license_revision,updated_at")
            .in("id", productIds);
        products = productResult.data ?? [];
    }
    if (reportIds.length) {
        const validationResult = await supabase.from("marketplace_validation_reports")
            .select("id,upload_id,passed,diagnostics,malware_scan_result,secret_scan_result,managed_validation_result,validator_version,validator_fingerprint_sha256,policy_version,package_sha256,manifest_sha256,evidence_storage_path,evidence_sha256,evidence_size_bytes,attestation_key_id,completed_at")
            .in("id", reportIds);
        validationReports = validationResult.data ?? [];
    }
    if (officialPublisherResult.data?.id) {
        const officialProductResult = await supabase.from("marketplace_products")
            .select("id,slug,display_name,state,updated_at")
            .eq("publisher_id", officialPublisherResult.data.id).order("display_name");
        officialProducts = officialProductResult.data ?? [];
        const officialProductIds = officialProducts.map((product: any) => product.id);
        if (officialProductIds.length) {
            const officialVersionResult = await supabase.from("marketplace_product_versions")
                .select("id,product_id,version,state,updated_at")
                .in("product_id", officialProductIds).order("updated_at", { ascending: false });
            officialVersions = officialVersionResult.data ?? [];
        }
    }
}

const versionById = new Map(versions.map((version: any) => [version.id, version]));
const productById = new Map(products.map((product: any) => [product.id, product]));
const validationById = new Map(validationReports.map((report: any) => [report.id, report]));
const publicationJobByVersionId = new Map(publicationJobs.map((job: any) => [job.version_id, job]));
const latestOfficialVersionByProduct = new Map<string, any>();
for (const version of officialVersions) {
    if (!latestOfficialVersionByProduct.has(version.product_id)) latestOfficialVersionByProduct.set(version.product_id, version);
}
const slugify = (value: string) => value.toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "").slice(0, 63) || "publisher";
const activeStaff = staff.filter((member: any) => member.active).length;
const actionableSubmissionCount = activeSubmissions.length + signingSubmissions.length;
---

<PlatformLayout title={allowed ? "Staff operations" : "Page not found"} active="marketplace"
    description="Kéire staff identity, marketplace validation, moderation, and launch controls." robots="noindex">
    {allowed ? (
        <section class="platform-section staff-console">
            <div class="platform-shell">
                <div class="section-heading staff-console__heading">
                    <div>
                        <p class="eyebrow">Staff · MFA verified · audited</p>
                        <h1>Operations center</h1>
                    </div>
                    <div class="staff-console__identity">
                        <span class="status-badge status-badge--ready">{staffRole}</span>
                        <small>{user?.email}</small>
                    </div>
                </div>

                <div class="staff-metrics" aria-label="Moderation queue summary">
                    <article><strong>{applications.length}</strong><span>Publisher applications</span></article>
                    <article><strong>{actionableSubmissionCount}</strong><span>Package actions</span></article>
                    <article><strong>{reports.length}</strong><span>Open reports</span></article>
                    <article><strong>{activeStaff}</strong><span>Active staff</span></article>
                </div>

                <div class="dashboard-grid publisher-dashboard">
                    <nav class="dashboard-nav" aria-label="Staff operations">
                        <a href="#applications" aria-current="page">Applications</a>
                        <a href="#packages">Packages</a>
                        <a href="#official-releases">Official releases</a>
                        <a href="#review-history">Review history</a>
                        <a href="#reports">Reports</a>
                        <a href="#staff">Staff</a>
                        <a href="#readiness">Launch readiness</a>
                        <a href="#gates">Feature gates</a>
                        <a href="#audit">Audit trail</a>
                    </nav>

                    <div class="publisher-workspace">
                        <section id="applications" class="publisher-section">
                            <div class="publisher-section__heading">
                                <div><p class="eyebrow">Identity review</p><h2>Publisher applications</h2></div>
                                <span class="status-badge">{applications.length} waiting</span>
                            </div>
                            {applications.length ? <div class="staff-card-grid">
                                {applications.map((application: any) => <article class="staff-review-card">
                                    <div class="staff-review-card__header">
                                        <div><h3>{application.public_name}</h3><code>{application.id}</code></div>
                                        <span class="status-badge">{application.state}</span>
                                    </div>
                                    <dl class="staff-detail-grid">
                                        <div><dt>Applicant</dt><dd><code>{application.applicant_user_id}</code></dd></div>
                                        <div><dt>Organization</dt><dd><code>{application.organization_id}</code></dd></div>
                                        <div><dt>Submitted</dt><dd>{new Date(application.submitted_at).toLocaleString()}</dd></div>
                                        <div><dt>Website</dt><dd>{application.website_url ? <a href={application.website_url} rel="noreferrer">Open website</a> : "Not provided"}</dd></div>
                                    </dl>
                                    <div class="staff-statement"><strong>Publishing statement</strong><p>{application.statement}</p></div>
                                    <form class="staff-action-form" data-moderation-form>
                                        <input type="hidden" name="operation" value="application.decide" />
                                        <input type="hidden" name="applicationId" value={application.id} />
                                        <label class="field"><span>Publisher URL slug</span><input name="publisherSlug" value={slugify(application.public_name)} minlength="3" maxlength="63" pattern="[a-z0-9][a-z0-9-]{2,62}" required /></label>
                                        <label class="field"><span>Decision note</span><textarea name="decisionNote" minlength="3" maxlength="5000" placeholder="Record the evidence and reasoning for this decision." required></textarea></label>
                                        <div class="actions staff-decision-actions">
                                            <button class="button button--secondary" type="submit" name="decision" value="changes_requested">Request changes</button>
                                            <button class="button button--quiet" type="submit" name="decision" value="rejected" data-confirm="Reject this publisher application?">Reject</button>
                                            <button class="button" type="submit" name="decision" value="approved" data-confirm="Approve this publisher and activate its organization?">Approve publisher</button>
                                        </div>
                                        <p class="form-message" role="status" aria-live="polite"></p>
                                    </form>
                                </article>)}
                            </div> : <p class="notice-panel">No publisher applications are waiting for review.</p>}
                        </section>

                        <section id="packages" class="publisher-section">
                            <div class="publisher-section__heading">
                                <div><p class="eyebrow">Validated evidence</p><h2>Active package review</h2></div>
                                <span class="status-badge">{activeSubmissions.length} awaiting decision</span>
                            </div>
                            {activeSubmissions.length ? <div class="staff-card-grid">
                                {activeSubmissions.map((submission: any) => {
                                    const version = versionById.get(submission.version_id) as any;
                                    const product = productById.get(version?.product_id) as any;
                                    const validation = validationById.get(submission.validation_report_id) as any;
                                    const diagnostics = Array.isArray(validation?.diagnostics) ? validation.diagnostics : [];
                                    return <article class="staff-review-card">
                                        <div class="staff-review-card__header">
                                            <div><h3>{product?.display_name ?? "Unknown product"} <small>{version?.version}</small></h3><code>{submission.id}</code></div>
                                            <span class:list={["status-badge", validation?.passed && "status-badge--ready"]}>{submission.state}</span>
                                        </div>
                                        <dl class="staff-detail-grid">
                                            <div><dt>Package SHA-256</dt><dd><code>{validation?.package_sha256 ?? "Unavailable"}</code></dd></div>
                                            <div><dt>Manifest SHA-256</dt><dd><code>{validation?.manifest_sha256 ?? "Unavailable"}</code></dd></div>
                                            <div><dt>Malware scan</dt><dd>{validation?.malware_scan_result ?? "Unavailable"}</dd></div>
                                            <div><dt>Secret scan</dt><dd>{validation?.secret_scan_result ?? "Unavailable"}</dd></div>
                                            <div><dt>Managed validation</dt><dd>{validation?.managed_validation_result ?? "Unavailable"}</dd></div>
                                            <div><dt>Validator</dt><dd>{validation?.validator_version ?? "Unavailable"}</dd></div>
                                        </dl>
                                        <div class="staff-statement"><strong>Diagnostics</strong><p>{diagnostics.length ? `${diagnostics.length} issue(s) reported.` : "No validator diagnostics."}</p></div>
                                        {validation?.evidence_sha256 && validation?.attestation_key_id ? <section class="staff-evidence" aria-label="Signed package review evidence">
                                            <div class="staff-evidence__heading">
                                                <div><strong>Signed review evidence</strong><small>Attested by <code>{validation.attestation_key_id}</code></small></div>
                                                <span class="status-badge status-badge--ready">verified metadata</span>
                                            </div>
                                            <p>Load the validator’s bounded report to inspect the exact manifest inventory without receiving the publisher’s private package archive.</p>
                                            <button class="button button--secondary" type="button" data-evidence-button data-report-id={validation.id}>Load verified report</button>
                                            <div class="staff-evidence__panel" data-evidence-panel hidden aria-live="polite"></div>
                                        </section> : <p class="notice-panel">Signed review evidence is unavailable for this legacy validation report.</p>}
                                        <form class="staff-action-form" data-moderation-form>
                                            <input type="hidden" name="operation" value="submission.decide" />
                                            <input type="hidden" name="submissionId" value={submission.id} />
                                            <label class="field"><span>Decision note</span><textarea name="decisionNote" maxlength="10000" placeholder="Required for changes or rejection; recommended for approval."></textarea></label>
                                            <div class="actions staff-decision-actions">
                                                <button class="button button--quiet" type="submit" name="decision" value="in_review">Claim review</button>
                                                <button class="button button--secondary" type="submit" name="decision" value="changes_requested">Request changes</button>
                                                <button class="button button--quiet" type="submit" name="decision" value="rejected" data-confirm="Reject this package submission?">Reject</button>
                                                <button class="button" type="submit" name="decision" value="approved_pending_signature" data-confirm="Approve this signed validator evidence and queue automatic publication?">Approve and queue publication</button>
                                            </div>
                                            <p class="form-message" role="status" aria-live="polite"></p>
                                        </form>
                                    </article>;
                                })}
                            </div> : <p class="notice-panel">No validated package submissions are waiting for staff review.</p>}

                            <div class="publisher-section__heading staff-subsection-heading">
                                <div><p class="eyebrow">Administrator boundary</p><h2>Automatic publication queue</h2></div>
                                <span class="status-badge">{signingSubmissions.length} approved</span>
                            </div>
                            {signingSubmissions.length ? <div class="staff-card-grid">
                                {signingSubmissions.map((submission: any) => {
                                    const version = versionById.get(submission.version_id) as any;
                                    const product = productById.get(version?.product_id) as any;
                                    const validation = validationById.get(submission.validation_report_id) as any;
                                    const publicationJob = publicationJobByVersionId.get(submission.version_id) as any;
                                    return <article class="staff-review-card">
                                        <div class="staff-review-card__header">
                                            <div><h3>{product?.display_name ?? "Unknown product"} <small>{version?.version}</small></h3><code>{submission.id}</code></div>
                                            <span class:list={["status-badge", publicationJob?.state !== "failed" && "status-badge--ready"]}>{publicationJob?.state ?? "queued"}</span>
                                        </div>
                                        <dl class="staff-detail-grid">
                                            <div><dt>Package SHA-256</dt><dd><code>{validation?.package_sha256 ?? "Unavailable"}</code></dd></div>
                                            <div><dt>Manifest SHA-256</dt><dd><code>{validation?.manifest_sha256 ?? "Unavailable"}</code></dd></div>
                                            <div><dt>Archive size</dt><dd>{Number(version?.archive_size_bytes ?? 0).toLocaleString()} bytes</dd></div>
                                            <div><dt>Approved</dt><dd>{submission.decided_at ? new Date(submission.decided_at).toLocaleString() : "Unavailable"}</dd></div>
                                            <div><dt>Publication attempts</dt><dd>{publicationJob?.attempt_count ?? 0}</dd></div>
                                            <div><dt>Last transition</dt><dd>{publicationJob?.updated_at ? new Date(publicationJob.updated_at).toLocaleString() : "Waiting for signer"}</dd></div>
                                        </dl>
                                        {staffRole === "administrator" ? <>
                                            <p class="notice-panel">The least-privileged publication signer processes this approval automatically. It receives signed metadata only, verifies the isolated validator’s attestation, and cannot download or alter the package.</p>
                                            {publicationJob?.last_error_code && <p class="form-message" data-kind="error">Last safe failure: <code>{publicationJob.last_error_code}</code>. Retry policy remains bounded.</p>}
                                            <form class="staff-action-form staff-withdrawal-form" data-moderation-form>
                                                <input type="hidden" name="operation" value="submission.decide" />
                                                <input type="hidden" name="submissionId" value={submission.id} />
                                                <label class="field"><span>Withdrawal reason</span><textarea name="decisionNote" minlength="3" maxlength="10000" placeholder="Explain why these approved bytes must not be published." required></textarea></label>
                                                <div class="actions"><button class="button button--quiet" type="submit" name="decision" value="rejected" data-confirm="Withdraw signing approval and reject this release? The audit record will be retained.">Withdraw approval</button></div>
                                                <p class="form-message" role="status" aria-live="polite"></p>
                                            </form>
                                        </> : <p class="notice-panel">An administrator must publish or withdraw this signing approval.</p>}
                                    </article>;
                                })}
                            </div> : <p class="notice-panel">No package release is waiting for automatic publication.</p>}
                        </section>

                        <section id="official-releases" class="publisher-section">
                            <div class="publisher-section__heading">
                                <div><p class="eyebrow">Kéire first-party content</p><h2>Official release drafts</h2></div>
                                <span class="status-badge">Same trust pipeline</span>
                            </div>
                            <p class="notice-panel">Built-in catalog cards are product drafts, not packages. Prepare a deterministic <code>.keireassetpackage</code>, upload it once through the Publisher portal, then pass isolated validation and evidence-based moderation. Approved official assets use the same automatic signature and immutable publication path as every other publisher.</p>
                            {officialProducts.length ? <div class="staff-card-grid">
                                {officialProducts.map((product: any) => {
                                    const latestVersion = latestOfficialVersionByProduct.get(product.id);
                                    return <article class="staff-review-card staff-flag-card">
                                        <div class="staff-review-card__header">
                                            <div><h3>{product.display_name}</h3><code>{product.slug}</code></div>
                                            <span class:list={["status-badge", product.state === "published" && "status-badge--ready"]}>{product.state}</span>
                                        </div>
                                        <p>{latestVersion ? `Latest release ${latestVersion.version} is ${latestVersion.state}.` : "No package version has been uploaded yet."}</p>
                                        <div class="actions"><a class="button button--secondary" href={`/publisher/?product=${encodeURIComponent(product.id)}#new-release`}>{latestVersion ? "Open release workflow" : "Upload first release"}</a></div>
                                    </article>;
                                })}
                            </div> : <p class="notice-panel">No official Kéire catalog drafts are configured.</p>}
                        </section>

                        <section id="review-history" class="publisher-section">
                            <div class="publisher-section__heading">
                                <div><p class="eyebrow">Retained evidence</p><h2>Package review history</h2></div>
                                <span class="status-badge">Not an active queue</span>
                            </div>
                            <p class="fine-print">Rejected and change-requested entries are removed from active work immediately. Their decision, reason, hashes, and actor remain available here and in the append-only audit trail.</p>
                            {submissionHistory.length ? <div class="data-table-wrap"><table class="data-table"><thead><tr><th>Product</th><th>Version</th><th>Decision</th><th>Reason</th><th>Decided</th></tr></thead><tbody>
                                {submissionHistory.map((submission: any) => {
                                    const version = versionById.get(submission.version_id) as any;
                                    const product = productById.get(version?.product_id) as any;
                                    return <tr><td>{product?.display_name ?? "Unknown product"}</td><td><code>{version?.version ?? "—"}</code></td><td><span class="status-badge">{submission.state}</span></td><td>{submission.decision_note ?? "No note recorded"}</td><td>{submission.decided_at ? new Date(submission.decided_at).toLocaleString() : "—"}</td></tr>;
                                })}
                            </tbody></table></div> : <p class="notice-panel">No terminal package decisions have been recorded.</p>}
                        </section>

                        <section id="reports" class="publisher-section">
                            <div class="publisher-section__heading"><div><p class="eyebrow">Trust and safety</p><h2>Marketplace reports</h2></div></div>
                            {reports.length ? <div class="staff-card-grid">
                                {reports.map((report: any) => <article class="staff-review-card">
                                    <div class="staff-review-card__header"><div><h3>{report.reason}</h3><code>{report.id}</code></div><span class="status-badge">{report.state}</span></div>
                                    <p>{report.details || "No additional details were supplied."}</p>
                                    <form class="staff-action-form" data-moderation-form>
                                        <input type="hidden" name="operation" value="report.decide" />
                                        <input type="hidden" name="reportId" value={report.id} />
                                        <label class="field"><span>Resolution note</span><textarea name="resolutionNote" maxlength="5000" placeholder="Record investigation evidence and resulting action."></textarea></label>
                                        <div class="actions">
                                            <button class="button button--secondary" type="submit" name="state" value="triaged">Assign to me</button>
                                            <button class="button button--quiet" type="submit" name="state" value="dismissed" data-confirm="Dismiss this report?">Dismiss</button>
                                            <button class="button" type="submit" name="state" value="resolved">Resolve</button>
                                        </div>
                                        <p class="form-message" role="status" aria-live="polite"></p>
                                    </form>
                                </article>)}
                            </div> : <p class="notice-panel">No marketplace reports require action.</p>}
                        </section>

                        <section id="staff" class="publisher-section">
                            <div class="publisher-section__heading"><div><p class="eyebrow">Least privilege</p><h2>Staff roles</h2></div><span class="status-badge">{staffRole}</span></div>
                            <p class="notice-panel">Moderators review identity, packages, and reports. Administrators additionally manage staff and feature gates. Every change requires MFA and an audit reason.</p>
                            <div class="data-table-wrap"><table class="data-table"><thead><tr><th>Account ID</th><th>Role</th><th>Status</th><th>Updated</th></tr></thead><tbody>
                                {staff.map((member: any) => <tr><td><code>{member.user_id}</code></td><td>{member.role}</td><td><span class:list={["status-badge", member.active && "status-badge--ready"]}>{member.active ? "active" : "revoked"}</span></td><td>{new Date(member.updated_at).toLocaleString()}</td></tr>)}
                            </tbody></table></div>
                            {staffRole === "administrator" && <form class="publisher-upload staff-role-form" data-moderation-form>
                                <input type="hidden" name="operation" value="staff.set" />
                                <div class="publisher-upload__grid">
                                    <label class="field"><span>Existing account ID</span><input name="targetUserId" pattern="[0-9a-fA-F-]{36}" maxlength="36" required /></label>
                                    <label class="field"><span>Role</span><select name="role"><option value="moderator">Moderator</option><option value="administrator">Administrator</option></select></label>
                                    <label class="field"><span>Status</span><select name="active"><option value="true">Active</option><option value="false">Revoked</option></select></label>
                                    <label class="field publisher-upload__wide"><span>Audit reason</span><textarea name="reason" minlength="3" maxlength="1000" required></textarea></label>
                                </div>
                                <div class="actions"><button class="button" type="submit">Apply staff assignment</button></div>
                                <p class="form-message" role="status" aria-live="polite"></p>
                            </form>}
                        </section>

                        <section id="gates" class="publisher-section">
                            <div class="publisher-section__heading"><div><p class="eyebrow">Controlled rollout</p><h2>Feature gates</h2></div></div>
                            <div class="staff-card-grid">
                                {flags.map((flag: any) => <article class="staff-review-card staff-flag-card">
                                    <div class="staff-review-card__header"><div><h3>{flag.key}</h3><p>{flag.description}</p></div><span class:list={["status-badge", flag.enabled && "status-badge--ready"]}>{flag.enabled ? "enabled" : "disabled"}</span></div>
                                    {staffRole === "administrator" && <form class="staff-action-form" data-moderation-form>
                                        <input type="hidden" name="operation" value="feature.set" />
                                        <input type="hidden" name="key" value={flag.key} />
                                        <label class="field"><span>Desired state</span><select name="enabled" disabled={flag.key === "paid_checkout_enabled"}><option value="false" selected={!flag.enabled}>Disabled</option><option value="true" selected={flag.enabled}>Enabled</option></select></label>
                                        <label class="field"><span>Audit reason</span><input name="reason" minlength="3" maxlength="1000" required /></label>
                                        <div class="actions"><button class="button button--secondary" type="submit" disabled={flag.key === "paid_checkout_enabled"}>Update gate</button></div>
                                        <p class="form-message" role="status" aria-live="polite"></p>
                                    </form>}
                                </article>)}
                            </div>
                        </section>

                        <section id="readiness" class="publisher-section">
                            <div class="publisher-section__heading">
                                <div><p class="eyebrow">Acceptance evidence</p><h2>Launch readiness</h2></div>
                                <span class="status-badge status-badge--ready">Audited 12 Aug 2026</span>
                            </div>
                            <ReadinessProgress completed={completedReadinessChecks} total={totalReadinessChecks} label="Kéire 0.3.1 launch checklist" />
                            <div class="staff-card-grid">
                                {launchReadinessTracks.map((track) => <article class="staff-review-card staff-flag-card">
                                    <div class="staff-review-card__header">
                                        <div><h3>{track.title}</h3><p>{track.delivered}</p></div>
                                        <span class="status-badge">{track.status}</span>
                                    </div>
                                    <ReadinessProgress completed={track.completed} total={track.total} label={track.title} compact />
                                    <p class="fine-print"><strong>Remaining:</strong> {track.remaining}</p>
                                </article>)}
                            </div>
                            <div class="actions"><a class="button button--secondary" href="/docs/reference/production-readiness-review/">Open production review</a><a class="button button--quiet" href="/docs/reference/marketplace-launch/">Review launch runbook</a></div>
                        </section>

                        <section id="audit" class="publisher-section">
                            <div class="publisher-section__heading"><div><p class="eyebrow">Append-only evidence</p><h2>Recent audit trail</h2></div></div>
                            {audits.length ? <div class="data-table-wrap"><table class="data-table"><thead><tr><th>Time</th><th>Action</th><th>Target</th><th>Actor</th></tr></thead><tbody>
                                {audits.map((event: any) => <tr><td>{new Date(event.occurred_at).toLocaleString()}</td><td>{event.action}</td><td>{event.target_type}<small>{event.target_id}</small></td><td><code>{event.actor_user_id ?? "service"}</code></td></tr>)}
                            </tbody></table></div> : <p class="notice-panel">No audit events are visible.</p>}
                        </section>
                    </div>
                </div>
            </div>
        </section>
    ) : <section class="platform-section"><div class="platform-shell empty-state"><h1>Page not found.</h1></div></section>}
</PlatformLayout>

<script>
    async function responseData(response: Response) {
        const payload = await response.json().catch(() => null);
        if (!response.ok) throw new Error(payload?.error?.message ?? "The staff operation failed.");
        return payload?.data;
    }

    document.querySelectorAll<HTMLFormElement>("[data-moderation-form]").forEach((form) => {
        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
            if (submitter?.dataset.confirm && !window.confirm(submitter.dataset.confirm)) return;
            const message = form.querySelector<HTMLElement>(".form-message");
            const controls = form.querySelectorAll<HTMLButtonElement | HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("button,input,select,textarea");
            const values = new FormData(form);
            const payload: Record<string, unknown> = Object.fromEntries(values.entries());
            if (submitter?.name) payload[submitter.name] = submitter.value;
            if (typeof payload.active === "string") payload.active = payload.active === "true";
            if (typeof payload.enabled === "string") payload.enabled = payload.enabled === "true";
            controls.forEach((control) => control.disabled = true);
            if (message) { message.textContent = "Applying audited operation…"; message.dataset.kind = ""; }
            try {
                await responseData(await fetch("/admin/marketplace/v1/actions/", {
                    method: "POST",
                    credentials: "same-origin",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload),
                }));
                if (message) { message.textContent = "Operation completed and recorded in the audit trail."; message.dataset.kind = "success"; }
                window.setTimeout(() => window.location.reload(), 700);
            } catch (error) {
                if (message) { message.textContent = error instanceof Error ? error.message : "The staff operation failed."; message.dataset.kind = "error"; }
                controls.forEach((control) => control.disabled = false);
            }
        });
    });

    function hex(bytes: Uint8Array) {
        return Array.from(bytes, (value) => value.toString(16).padStart(2, "0")).join("");
    }

    function element<K extends keyof HTMLElementTagNameMap>(name: K, text?: string) {
        const node = document.createElement(name);
        if (text !== undefined) node.textContent = text;
        return node;
    }

    function renderEvidence(panel: HTMLElement, evidence: any, fingerprint: string) {
        panel.replaceChildren();
        const inventory = evidence?.inventory;
        const files = Array.isArray(inventory?.files) ? inventory.files : [];
        const heading = element("div");
        heading.className = "staff-evidence__summary";
        heading.append(
            element("strong", inventory ? `${inventory.displayName} ${inventory.version}` : "Validation evidence"),
            element("small", `${files.length.toLocaleString()} files · key ${fingerprint}`),
        );
        panel.append(heading);
        if (!inventory) {
            panel.append(element("p", "The validator failed before a safe package inventory could be produced."));
            return;
        }

        const controls = element("div");
        controls.className = "staff-evidence__controls";
        const search = element("input") as HTMLInputElement;
        search.type = "search";
        search.placeholder = "Filter manifest paths";
        search.setAttribute("aria-label", "Filter manifest paths");
        const previous = element("button", "Previous") as HTMLButtonElement;
        const next = element("button", "Next") as HTMLButtonElement;
        previous.type = next.type = "button";
        previous.className = next.className = "button button--quiet";
        const pageStatus = element("span");
        controls.append(search, previous, pageStatus, next);
        const list = element("ol");
        list.className = "staff-evidence__files";
        panel.append(controls, list);

        let page = 0;
        const pageSize = 50;
        const draw = () => {
            const query = search.value.trim().toLocaleLowerCase();
            const filtered = query ? files.filter((file: any) => String(file?.path ?? "").toLocaleLowerCase().includes(query)) : files;
            const pages = Math.max(1, Math.ceil(filtered.length / pageSize));
            page = Math.min(page, pages - 1);
            list.replaceChildren(...filtered.slice(page * pageSize, (page + 1) * pageSize).map((file: any) => {
                const item = element("li");
                item.append(element("code", String(file?.path ?? "Unknown path")), element("span", `${Number(file?.sizeBytes ?? 0).toLocaleString()} bytes`));
                return item;
            }));
            if (!filtered.length) list.append(element("li", "No manifest paths match this filter."));
            pageStatus.textContent = `${filtered.length.toLocaleString()} files · page ${page + 1} of ${pages}`;
            previous.disabled = page === 0;
            next.disabled = page >= pages - 1;
        };
        search.addEventListener("input", () => { page = 0; draw(); });
        previous.addEventListener("click", () => { page -= 1; draw(); });
        next.addEventListener("click", () => { page += 1; draw(); });
        draw();
    }

    document.querySelectorAll<HTMLButtonElement>("[data-evidence-button]").forEach((button) => {
        button.addEventListener("click", async () => {
            const panel = button.parentElement?.querySelector<HTMLElement>("[data-evidence-panel]");
            const reportId = button.dataset.reportId;
            if (!panel || !reportId) return;
            button.disabled = true;
            panel.hidden = false;
            panel.textContent = "Verifying attestation and loading bounded review evidence…";
            try {
                const grant = await responseData(await fetch("/admin/marketplace/v1/actions/", {
                    method: "POST",
                    credentials: "same-origin",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ operation: "evidence.issue", reportId }),
                }));
                const response = await fetch(grant.url, { credentials: "omit", cache: "no-store" });
                if (!response.ok) throw new Error("The signed evidence download expired or was rejected.");
                const bytes = new Uint8Array(await response.arrayBuffer());
                const digest = hex(new Uint8Array(await crypto.subtle.digest("SHA-256", bytes)));
                if (bytes.byteLength !== grant.sizeBytes || digest !== grant.sha256) {
                    throw new Error("The review evidence failed its SHA-256 or size check.");
                }
                const evidence = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(bytes));
                if (evidence?.schemaVersion !== 1) throw new Error("The review evidence schema is unsupported.");
                renderEvidence(panel, evidence, grant.attestationFingerprint);
                button.textContent = "Reload verified report";
            } catch (error) {
                panel.textContent = error instanceof Error ? error.message : "The review evidence could not be verified.";
                panel.dataset.kind = "error";
            } finally {
                button.disabled = false;
            }
        });
    });
</script>
