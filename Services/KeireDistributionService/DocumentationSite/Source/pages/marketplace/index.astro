---
import MarketplaceCard from "../../components/MarketplaceCard.astro";
import PlatformLayout from "../../layouts/PlatformLayout.astro";
import { loadMarketplaceCatalog } from "../../lib/marketplace";

export const prerender = false;

const supabase = Astro.locals.supabase;
const search = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 100);
const category = (Astro.url.searchParams.get("category") ?? "").trim().slice(0, 64);
const { status, products, categories } = await loadMarketplaceCatalog(supabase, search, category);
if (status !== "ready") Astro.response.status = 503;
Astro.response.headers.set("cache-control", status !== "ready" || Astro.locals.user ? "private, no-store" : "public, max-age=60, stale-while-revalidate=300");
---

<PlatformLayout title="Marketplace" description="Discover verified free content, tools, shaders, VFX, and gameplay packages for Kéire Engine." active="marketplace">
    <section class="platform-section marketplace-catalog"><div class="platform-shell">
        <div class="section-heading"><div><p class="eyebrow">Kéire Marketplace</p><h1>Find a starting point for your next idea.</h1></div><p>Browse free assets, tools, and examples for Kéire. Each published package includes its version, compatibility, and publisher details so you can decide whether it fits your project.</p></div>
        <p class="fine-print">Browse without an account. Sign in to add free assets to your library. Paid purchases are not available.</p>
        <form class="market-toolbar" method="get" role="search">
            <label class="search-field"><span>Search assets</span><input type="search" name="q" value={search} placeholder="Shaders, VFX, gameplay, UI…" maxlength="100" /></label>
            <label class="field"><span>Category</span><select name="category"><option value="">All categories</option>{categories.map((item) => <option value={item.slug} selected={item.slug === category}>{item.display_name}</option>)}</select></label>
            <button class="button" type="submit">Search</button>
        </form>
        {status !== "ready" ? <div class="empty-state"><p class="eyebrow">Catalog temporarily unavailable</p><h2>We couldn’t load the assets right now.</h2><p>Free assets can be browsed without signing in. Please try again shortly.</p><a class="button button--secondary" href={Astro.url.pathname + Astro.url.search}>Try again</a></div>
        : products.length === 0 && (search || category) ? <div class="empty-state"><h2>No products matched.</h2><p>Try a broader search or remove the category filter.</p><a class="text-action" href="/marketplace/">Clear filters →</a></div>
        : products.length === 0 ? <div class="empty-state"><h2>No published assets yet.</h2><p>Published free assets will appear here as they become available.</p></div>
        : <div class="market-grid">{products.map((product) => <MarketplaceCard product={product} />)}</div>}
    </div></section>
    <section class="platform-section platform-section--line platform-section--compact"><div class="platform-shell cta-band"><div><p class="eyebrow">Build for Kéire</p><h2>Share something useful.</h2></div><div class="actions"><a class="button" href="/publisher/">Publisher portal</a><a class="button button--secondary" href="/docs/reference/asset-packages/">Package documentation</a><a class="button button--quiet" href="/roadmap/">Launch roadmap</a></div></div></section>
</PlatformLayout>
