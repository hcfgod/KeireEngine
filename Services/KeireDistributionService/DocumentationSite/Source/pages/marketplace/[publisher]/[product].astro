---
import PlatformLayout from "../../../layouts/PlatformLayout.astro";
import AssetDescription from "../../../components/AssetDescription.astro";
import { marketplaceEnabled } from "../../../lib/marketplace";
import { loadOffer, offerPrice, purchaseState } from "../../../lib/marketplace-purchase";

export const prerender = false;

const { publisher, product } = Astro.params;
const supabase = Astro.locals.supabase;
const localView = Astro.locals.localProductView;
let listing: any = null;
let versions: any[] = [];
let ownsPersonalCopy = false;
let offer = null;
let offerLoadFailed = false;
if (localView) {
    listing = localView.product;
    versions = listing?.versions ?? [];
    offer = listing?.offer ?? null;
    ownsPersonalCopy = localView.ownsPersonalCopy;
    if (!localView.enabled) Astro.response.status = 503;
} else if (supabase && await marketplaceEnabled(supabase)) {
    const result = await supabase.from("marketplace_catalog").select("*")
        .eq("publisher_slug", publisher).eq("slug", product).maybeSingle();
    listing = result.data;
    if (listing) {
        try { offer = await loadOffer(supabase, listing.id); }
        catch { offerLoadFailed = true; }
        const versionResult = await supabase.from("marketplace_product_versions")
            .select("id,version,install_kind,minimum_engine_version,maximum_engine_version,platforms,architectures,release_notes_markdown,published_at,state")
            .eq("product_id", listing.id).in("state", ["published", "withdrawn", "security_revoked"])
            .order("published_at", { ascending: false });
        versions = versionResult.data ?? [];
        if (Astro.locals.user) {
            const entitlementResult = await supabase.from("marketplace_entitlements").select("id")
                .eq("product_id", listing.id).eq("user_id", Astro.locals.user.id)
                .is("organization_id", null).is("revoked_at", null).limit(1).maybeSingle();
            ownsPersonalCopy = Boolean(entitlementResult.data);
        }
    }
}
if (!listing && (!localView || localView.enabled)) {
    Astro.response.status = 404;
}
const structuredData = listing ? {
    "@context": "https://schema.org", "@type": "Product", name: listing.display_name,
    description: listing.short_description, brand: { "@type": "Organization", name: listing.publisher_name },
    aggregateRating: listing.rating_count > 0 ? { "@type": "AggregateRating", ratingValue: listing.rating_average, reviewCount: listing.rating_count } : undefined,
} : undefined;
const currentVersion = versions.find((version) => version.state === "published");
const acquisition = purchaseState(offer, ownsPersonalCopy, Boolean(currentVersion));
const acceptedLicense = listing ? JSON.stringify({
    licenseSpdx: listing.license_spdx,
    licenseRevision: listing.license_revision,
    acceptedLicenseSnapshot: listing.license_acceptance_snapshot,
}) : "";
const openActionLabel = currentVersion?.install_kind === "complete_project" ? "Create in Hub" : "Open in Editor";
---

<PlatformLayout title={listing?.display_name ?? "Product not found"} description={listing?.short_description ?? "The requested Kéire Marketplace product is unavailable."} active="marketplace" robots={listing ? "index,follow" : "noindex"} structuredData={structuredData}>
    {listing ? <>
        <section class="platform-shell product-hero">
            <div><p class="eyebrow">{listing.category_name} · {listing.license_spdx}</p><h1>{listing.display_name}</h1><p class="lead">{listing.short_description}</p><p>By <a href={`/marketplace/publishers/${listing.publisher_slug}/`}>{listing.publisher_name}</a>{listing.publisher_verified ? " · Verified publisher" : ""}</p></div>
            <aside class="product-buybox" aria-label="Get this asset">
                <span class="product-buybox__price">{offerPrice(offer)}</span>
                {acquisition.canClaim && <>
                    <details><summary>Review asset license</summary><pre class="asset-license">{listing.license_acceptance_snapshot}</pre></details>
                    <label><input type="checkbox" data-accept-license /> I accept this asset's license.</label>
                </>}
                <button class="button" type="button" data-claim-product={listing.id} data-claim-license={acceptedLicense}
                    data-local-acquisition={Boolean(localView)} disabled>
                    {offerLoadFailed ? "Pricing unavailable" : acquisition.label}
                </button>
                <p class="form-message" aria-live="polite" data-claim-message>
                    {offerLoadFailed && !ownsPersonalCopy
                        ? "We couldn't load pricing. Refresh this page to try again. You have not been charged."
                        : acquisition.message}
                </p>
                <a class="button button--secondary" href="/account/#library" data-library-link hidden={!ownsPersonalCopy}>
                    View My Assets
                </a>
                {currentVersion && !localView
                    ? <a class="button button--secondary" href={`keirehub://marketplace/product/${listing.id}`} data-open-product hidden={!ownsPersonalCopy}>{openActionLabel}</a>
                    : <span class="button button--secondary" aria-disabled="true">{currentVersion ? "Downloads temporarily unavailable" : "No published download"}</span>}
                {currentVersion && <p class="form-message">{localView
                    ? "Ownership is preserved while download delivery is migrated."
                    : "Kéire Hub securely prepares the signed package; project installation and import happen in the Editor Package Manager."}</p>}
            </aside>
        </section>
        <section class="platform-shell product-details">
            <article class="prose"><h2>About this asset</h2><AssetDescription text={listing.description_markdown} /><h2>Release history</h2>{versions.length ? versions.map((version) => <section><h3>{version.version}</h3><p>{version.release_notes_markdown || "No release notes were supplied."}</p><span class={`status-badge ${version.state === "published" ? "status-badge--ready" : ""}`}>{version.state}</span></section>) : <p>No compatible published version is currently available.</p>}</article>
            <aside><dl class="fact-list"><div><dt>Publisher</dt><dd>{listing.publisher_name}</dd></div><div><dt>License</dt><dd>{listing.license_spdx} ({listing.license_revision})</dd></div><div><dt>Rating</dt><dd>{Number(listing.rating_average).toFixed(1)} / 5 ({listing.rating_count})</dd></div><div><dt>Ownership</dt><dd>Perpetual personal or organization entitlement</dd></div></dl></aside>
        </section>
    </> : <section class="platform-section"><div class="platform-shell empty-state">
        <p class="eyebrow">{localView && !localView.enabled ? "Marketplace maintenance" : "404"}</p>
        <h1>Product unavailable.</h1>
        <p>{localView && !localView.enabled ? "The marketplace is temporarily disabled. Please try again later." : "The listing may not exist, may still be in review, or may have been delisted."}</p>
        <a class="button" href="/marketplace/">Return to Marketplace</a>
    </div></section>}
</PlatformLayout>

<script>
    const button = document.querySelector("[data-claim-product]");
    const message = document.querySelector("[data-claim-message]");
    const libraryLink = document.querySelector("[data-library-link]");
    const openProduct = document.querySelector("[data-open-product]");
    const acceptLicense = document.querySelector("[data-accept-license]");
    const claimAttemptKey = crypto.randomUUID();
    const claimTimeoutMilliseconds = 18_000;
    acceptLicense?.addEventListener("change", () => {
        if (button instanceof HTMLButtonElement && acceptLicense instanceof HTMLInputElement && !button.hasAttribute("aria-busy")) {
            button.disabled = !acceptLicense.checked;
        }
    });

    button?.addEventListener("click", async () => {
        if (!(button instanceof HTMLButtonElement) || !(message instanceof HTMLElement) || button.disabled ||
            !(acceptLicense instanceof HTMLInputElement) || !acceptLicense.checked) return;

        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), claimTimeoutMilliseconds);
        let completed = false;
        let redirecting = false;
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
        message.textContent = "Checking your account and license…";

        try {
            const response = await fetch("/marketplace/v1/claims/", {
                method: "POST",
                headers: { "content-type": "application/json", "idempotency-key": claimAttemptKey },
                body: JSON.stringify({ productId: button.dataset.claimProduct, ownership: "personal",
                    ...JSON.parse(button.dataset.claimLicense ?? "{}") }),
                cache: "no-store",
                credentials: "same-origin",
                signal: controller.signal,
            });
            const responseText = await response.text();
            let result = {};
            if (responseText) {
                try {
                    result = JSON.parse(responseText);
                } catch {
                    result = {};
                }
            }

            if (response.status === 401) {
                redirecting = true;
                location.href = `/account/sign-in/?next=${encodeURIComponent(location.pathname)}`;
                return;
            }
            if (!response.ok) {
                const apiMessage = result && typeof result === "object" && "error" in result
                    && result.error && typeof result.error === "object" && "message" in result.error
                    && typeof result.error.message === "string"
                    ? result.error.message
                    : null;
                message.dataset.kind = "error";
                message.textContent = response.status >= 500
                    ? "We couldn't confirm the claim. Check My Assets; if it is not there, retry safely. You have not been charged."
                    : apiMessage ?? "The asset could not be claimed. Review the request and try again.";
                if (response.status >= 500 && libraryLink instanceof HTMLAnchorElement) libraryLink.hidden = false;
                return;
            }

            completed = true;
            acceptLicense.disabled = true;
            button.textContent = "In My Assets";
            message.dataset.kind = "success";
            message.textContent = button.dataset.localAcquisition === "true"
                ? "Added to your personal library. Downloads are temporarily unavailable during the backend migration."
                : "Added to your personal library. Open it in the Editor when you are ready.";
            if (libraryLink instanceof HTMLAnchorElement) libraryLink.hidden = false;
            if (openProduct instanceof HTMLAnchorElement && button.dataset.localAcquisition !== "true") openProduct.hidden = false;
        } catch (error) {
            message.dataset.kind = "error";
            message.textContent = error instanceof DOMException && error.name === "AbortError"
                ? "This is taking longer than expected. Check My Assets; if it is not there, retry safely."
                : "The connection was interrupted. Check My Assets; if it is not there, retry safely.";
            if (libraryLink instanceof HTMLAnchorElement) libraryLink.hidden = false;
        } finally {
            window.clearTimeout(timeout);
            button.removeAttribute("aria-busy");
            if (!completed && !redirecting) button.disabled = !acceptLicense.checked;
        }
    });
</script>

<style>
    .product-buybox [hidden] { display: none !important; }
    .asset-license { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 18rem; overflow: auto; }
</style>
