---
import PlatformLayout from "../../layouts/PlatformLayout.astro";
import ProductNavigation from "../../components/ProductNavigation.astro";
import ProductMedia from "../../components/ProductMedia.astro";
import { productFeatures } from "../../lib/product-features";
export const prerender = true;
---
<PlatformLayout title="Engine and Editor" description="Explore Kéire’s scene editor, Shader Graph, Inspector-based materials, VFX Graph, animation, C# scripting, and player builds." active="product">
    <ProductNavigation />
    <section class="platform-shell feature-detail">
        <div class="feature-detail__heading">
            <p class="eyebrow">The Kéire toolkit</p><h1>Big ideas.<br />Meet your tools.</h1>
            <p class="lead">Build a scene, find its look, and give it behavior. A connected creative toolkit, with the source open when you want to go deeper.</p>
            <div class="actions"><a class="button" href="/downloads/">Get Kéire Hub ↗</a><a class="text-action" href="/showcase/">See it in action →</a></div>
        </div>
        <ProductMedia name="editor" alt="The Outpost project open in Kéire’s scene editor." priority />
    </section>
    <section class="platform-section platform-shell">
        <div class="section-heading"><div><p class="eyebrow">Choose your discipline</p><h2>Everything starts<br />with an idea.</h2></div><p>Find a focused overview of each toolset, with guides to take you from exploring to creating.</p></div>
        <div class="feature-cards">{productFeatures.map((feature, index) => <a class="feature-card" href={`/features/${feature.id}/`}>
            <ProductMedia name={feature.image} alt={feature.alt} />
            <div><span class="eyebrow">0{index + 1} / {feature.label}</span><h3>{feature.title}</h3><p>{feature.summary}</p><span class="text-action">Explore {feature.label} ↗</span></div>
        </a>)}</div>
    </section>
    <section class="platform-shell feature-next">
        <div><p class="eyebrow">See the result</p><h2>A project you can look inside.</h2><p>The Outpost brings the editor, materials, and effects into one demonstration scene.</p><a class="button button--secondary" href="/showcase/">Explore the showcase ↗</a></div>
        <aside><strong>Know the current boundaries.</strong><p>Kéire is an independent, pre-1.0 engine. Check current platform support and capability limits when evaluating it for a project.</p><a class="text-action" href="/docs/reference/production-readiness-review/">Read the production review →</a></aside>
    </section>
</PlatformLayout>
