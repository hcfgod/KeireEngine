---
import PlatformLayout from "../../layouts/PlatformLayout.astro";
import { roadmapHorizons } from "../../lib/roadmap";

export const prerender = true;

const structuredData = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "Kéire Engine roadmap",
    description: "The current direction for Kéire 0.4.0 toward a production-proven 1.0 release.",
    dateModified: "2026-08-22",
};
---

<PlatformLayout title="Roadmap" description="Follow Kéire Engine's Now, Next, and Later product direction from the current 0.4.0 release toward a production-proven 1.0 release." active="roadmap" structuredData={structuredData}>
    <section class="platform-section roadmap-hero">
        <div class="platform-shell roadmap-hero__grid">
            <div class="roadmap-hero__copy">
                <p class="eyebrow">Product direction</p>
                <h1>The path from Kéire 0.4.0 to a production-proven engine.</h1>
                <p class="lead">Kéire is building outward from a reliable engine, Editor, and Hub foundation. This roadmap describes the outcomes we are pursuing—not fictional precision or a percentage masquerading as readiness.</p>
                <div class="actions">
                    <a class="button" href="/changelog/0.4.0/">Review the 0.4.0 release</a>
                    <a class="button button--secondary" href="/docs/reference/production-readiness-review/">Read the production review</a>
                </div>
            </div>
            <aside class="roadmap-current" aria-label="Current Kéire release direction">
                <span>Current focus</span>
                <strong>Finish 0.4.0 publication without bypassing signed catalog activation.</strong>
                <dl>
                    <div><dt>Source</dt><dd>0.4.0 current</dd></div>
                    <div><dt>Packages</dt><dd>Signed catalog activation required</dd></div>
                    <div><dt>Public platforms</dt><dd>Windows + Linux x86-64</dd></div>
                    <div><dt>Priority</dt><dd>Reliability and evidence</dd></div>
                </dl>
            </aside>
        </div>
    </section>

    <nav class="roadmap-index platform-section--line" aria-label="Roadmap horizons">
        <div class="platform-shell">
            {roadmapHorizons.map((horizon, index) => (
                <a href={`#${horizon.id}`}>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <strong>{horizon.label}</strong>
                    <small>{horizon.timeframe}</small>
                </a>
            ))}
        </div>
    </nav>

    <div class="roadmap-horizons">
        {roadmapHorizons.map((horizon, horizonIndex) => (
            <section id={horizon.id} class:list={["platform-section", horizonIndex % 2 === 1 && "platform-section--line"]}>
                <div class="platform-shell roadmap-horizon">
                    <header class="roadmap-horizon__intro">
                        <div class="roadmap-horizon__number">{String(horizonIndex + 1).padStart(2, "0")}</div>
                        <p class="eyebrow">{horizon.timeframe}</p>
                        <h2>{horizon.label}</h2>
                        <p>{horizon.statement}</p>
                    </header>
                    <div class="roadmap-initiatives">
                        {horizon.initiatives.map((initiative, initiativeIndex) => (
                            <article data-reveal style={`--reveal-index: ${initiativeIndex}`}>
                                <header>
                                    <span class:list={["roadmap-status", `roadmap-status--${initiative.status.toLowerCase().replaceAll(" ", "-")}`]}>{initiative.status}</span>
                                    <span class="roadmap-initiative__index">{horizon.label.slice(0, 1)}{initiativeIndex + 1}</span>
                                </header>
                                <h3>{initiative.title}</h3>
                                <p>{initiative.outcome}</p>
                                <ul>
                                    {initiative.capabilities.map((capability) => <li>{capability}</li>)}
                                </ul>
                                {initiative.evidenceUrl && <a href={initiative.evidenceUrl}>Inspect current evidence <span aria-hidden="true">→</span></a>}
                            </article>
                        ))}
                    </div>
                </div>
            </section>
        ))}
    </div>

    <section class="platform-section roadmap-note">
        <div class="platform-shell cta-band">
            <div><p class="eyebrow">Roadmap policy</p><h2>Direction, not a delivery guarantee.</h2><p>Priorities can change as validation uncovers new risks. Work is considered shipped only when it appears in the changelog with the appropriate availability evidence.</p></div>
            <div class="actions"><a class="button" href="/changelog/">Open changelog</a><a class="button button--secondary" href="/docs/reference/marketplace-launch/">Marketplace gates</a></div>
        </div>
    </section>
</PlatformLayout>
