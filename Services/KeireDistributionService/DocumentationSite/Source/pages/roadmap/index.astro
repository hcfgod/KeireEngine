---
import PlatformLayout from "../../layouts/PlatformLayout.astro";
import { roadmapHorizons } from "../../lib/roadmap";
import { releaseStatus } from "../../lib/release-status";

export const prerender = true;

const structuredData = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "Kéire Engine roadmap",
    description: "The current direction for Kéire 0.4.4 toward a production-proven 1.0 release.",
    dateModified: "2026-08-28",
};
---

<PlatformLayout title="Roadmap" description="Follow Kéire Engine's Now, Next, and Later product direction from the current 0.4.4 source toward a production-proven 1.0 release." active="roadmap" structuredData={structuredData}>
    <section class="platform-section roadmap-hero">
        <div class="platform-shell roadmap-hero__grid">
            <div class="roadmap-hero__copy">
                <p class="eyebrow">Product direction</p>
                <h1>The next chapter<br />starts here.</h1>
                <p class="lead">We’re improving the engine, Editor, and Hub around the work of making a game. Here’s what we’re working on now, what comes next, and what still needs proving.</p>
                <div class="actions">
                    <a class="button" href={`/changelog/${releaseStatus.sourceVersion}/`}>Review {releaseStatus.sourceVersion} changes</a>
                    <a class="button button--secondary" href="/docs/reference/production-readiness-review/">Read the production review</a>
                </div>
            </div>
            <aside class="roadmap-current" aria-label="Current Kéire release direction">
                <span>Current focus</span>
                <strong>Make everyday development more reliable, with each platform tested before release.</strong>
                <dl>
                    <div><dt>Source</dt><dd>{releaseStatus.sourceVersion}</dd></div>
                    <div><dt>Packages</dt><dd>{releaseStatus.availableVersion}</dd></div>
                    <div><dt>Public platforms</dt><dd>Windows + Linux x86-64</dd></div>
                    <div><dt>Priority</dt><dd>Reliability and evidence</dd></div>
                </dl>
            </aside>
        </div>
    </section>

    <nav class="roadmap-index platform-section--line" aria-label="Roadmap horizons">
        <div class="platform-shell">
            {roadmapHorizons.map((horizon, index) => (
                <a href={`#${horizon.id}`}>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <strong>{horizon.label}</strong>
                    <small>{horizon.timeframe}</small>
                </a>
            ))}
        </div>
    </nav>

    <div class="platform-shell roadmap-board">
        {roadmapHorizons.map((horizon) => (
            <section id={horizon.id} class="roadmap-column">
                <header>
                    <p class="eyebrow">{horizon.timeframe}</p>
                    <h2>{horizon.label}</h2>
                    <p>{horizon.statement}</p>
                </header>
                <div>
                    {horizon.initiatives.map((initiative) => (
                        <article class="roadmap-item">
                            <header>
                                <span class:list={["roadmap-status", `roadmap-status--${initiative.status.toLowerCase().replaceAll(" ", "-")}`]}>{initiative.status}</span>
                            </header>
                            <h3>{initiative.title}</h3>
                            <p>{initiative.outcome}</p>
                            <details>
                                <summary>Capabilities &amp; evidence<span class="visually-hidden"> for {initiative.title}</span></summary>
                                <ul>
                                    {initiative.capabilities.map((capability) => <li>{capability}</li>)}
                                </ul>
                                {initiative.evidenceUrl && <a href={initiative.evidenceUrl}>Inspect current evidence <span aria-hidden="true">→</span></a>}
                            </details>
                        </article>
                    ))}
                </div>
            </section>
        ))}
    </div>

    <section class="platform-section roadmap-note">
        <div class="platform-shell cta-band">
            <div><p class="eyebrow">Roadmap policy</p><h2>Direction, not a delivery guarantee.</h2><p>Priorities can change as validation uncovers new risks. Work is considered shipped only when it appears in the changelog with the appropriate availability evidence.</p></div>
            <div class="actions"><a class="button" href="/changelog/">Open changelog</a><a class="button button--secondary" href="/docs/reference/marketplace-launch/">Marketplace gates</a></div>
        </div>
    </section>
</PlatformLayout>
