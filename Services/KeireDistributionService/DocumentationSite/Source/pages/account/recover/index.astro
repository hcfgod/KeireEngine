---
import PlatformLayout from "../../../layouts/PlatformLayout.astro";
export const prerender = false;
---
<PlatformLayout title="Recover account" description="Request a secure Kéire account password recovery email." robots="noindex">
    <section class="platform-shell account-shell"><div><p class="eyebrow">Account recovery</p><h1 class="display-title">Let’s get you<br /><span>back in.</span></h1><p class="lead">Resetting the website password does not silently reactivate revoked Hub device sessions.</p></div><div class="auth-card"><h2>Reset password</h2><form class="form-stack" data-recovery-form><label class="field"><span>Email address</span><input type="email" name="email" maxlength="254" autocomplete="email" required /></label><button class="button" type="submit">Send recovery email</button><p class="form-message" aria-live="polite" data-recovery-message></p></form></div></section>
</PlatformLayout>
<script>
    const form = document.querySelector<HTMLFormElement>("[data-recovery-form]");
    form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
        const message = form.querySelector<HTMLElement>("[data-recovery-message]")!;
        if (button.disabled) return;
        button.disabled = true;
        form.setAttribute("aria-busy", "true");
        message.textContent = "Requesting recovery email…";
        try {
            const response = await fetch("/account/recovery/", {
                method: "POST", headers: { "content-type": "application/json" },
                body: JSON.stringify({ email: new FormData(form).get("email") }),
                cache: "no-store", credentials: "same-origin", signal: AbortSignal.timeout(15000),
            });
            const result = await response.json();
            message.dataset.kind = response.ok ? "success" : "error";
            message.textContent = result.message ?? result.error?.message ?? "Recovery could not be requested. Try again.";
        } catch {
            message.dataset.kind = "error";
            message.textContent = "The connection was interrupted. Check your inbox before requesting another email.";
        } finally {
            button.disabled = false;
            form.removeAttribute("aria-busy");
        }
    });
</script>
