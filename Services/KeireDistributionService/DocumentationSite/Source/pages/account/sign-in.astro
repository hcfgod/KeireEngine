---
import PlatformLayout from "../../layouts/PlatformLayout.astro";
import { safeLocalPath } from "../../lib/auth";
export const prerender = false;
if (Astro.locals.user) return Astro.redirect("/account/", 303);
const safeNext = safeLocalPath(Astro.url.searchParams.get("next"));
const oauthError = Astro.url.searchParams.get("oauth_error");
const oauthMessages: Record<string, string> = {
    cancelled: "GitHub sign-in was cancelled. No account changes were made.",
    code_missing: "GitHub did not return a usable sign-in response. Start a new sign-in and complete it in the same browser.",
    exchange_failed: "The secure GitHub sign-in handshake could not be completed. Start again, finish in the same browser, and do not reuse an older callback tab.",
    unavailable: "Account sign-in is temporarily unavailable. Please try again in a moment.",
};
const oauthMessage = oauthError ? oauthMessages[oauthError] : undefined;
const referenceValue = Astro.url.searchParams.get("reference") ?? "";
const reference = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(referenceValue)
    ? referenceValue
    : "";
---
<PlatformLayout title="Sign in" description="Sign in to your Kéire account for website, Hub authorization, organizations, and Marketplace library access." robots="noindex">
    <section class="platform-shell account-shell">
        <div><p class="eyebrow">One identity, separate sessions</p><h1 class="display-title">Your Kéire account.<br /><span>Your devices.</span></h1><p class="lead">The website and Hub use the same identity authority, while each keeps an independently revocable session. Browser cookies and refresh tokens never transfer to Hub.</p></div>
        <div class="auth-card"><h2>Sign in</h2><p>Continue to your library, organizations, and connected devices.</p>
            {oauthMessage && <div class="auth-alert" role="alert"><strong>GitHub sign-in was not completed.</strong><p>{oauthMessage}</p>{reference && <p class="auth-alert__reference">Reference <code>{reference}</code></p>}</div>}
            <a class="button button--secondary" href={`/account/github/?next=${encodeURIComponent(safeNext)}`}>Continue with GitHub</a>
            <div class="divider">or use email</div>
            <form class="form-stack" data-auth-form data-next={safeNext}>
                <label class="field"><span>Email address</span><input type="email" name="email" autocomplete="email" maxlength="254" required /></label>
                <label class="field"><span>Password</span><input type="password" name="password" autocomplete="current-password" minlength="8" maxlength="256" required /></label>
                <button class="button" type="submit">Sign in securely</button>
                <p class="form-message" aria-live="polite" data-auth-message></p>
            </form>
            <p><a href="/account/recover/">Forgot your password?</a> · <a href="/account/create/">Create an account</a></p>
        </div>
    </section>
</PlatformLayout>
<script>
    const form = document.querySelector("[data-auth-form]");
    form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!(form instanceof HTMLFormElement)) return;
        const message = form.querySelector("[data-auth-message]");
        const submit = form.querySelector("button[type=submit]");
        if (submit instanceof HTMLButtonElement) submit.disabled = true;
        const values = new FormData(form);
        const response = await fetch("/account/session/", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ email: values.get("email"), password: values.get("password") }) });
        const result = await response.json();
        if (message instanceof HTMLElement) { message.dataset.kind = response.ok ? "success" : "error"; message.textContent = response.ok ? "Signed in. Loading your account…" : result.error?.message ?? "Sign-in failed."; }
        if (response.ok) {
            const next = form.dataset.next || "/account/";
            location.href = result.data?.mfaRequired
                ? `/account/mfa/challenge/?next=${encodeURIComponent(next)}`
                : next;
        }
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
    });
</script>
