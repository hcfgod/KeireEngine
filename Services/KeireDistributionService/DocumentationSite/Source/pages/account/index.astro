---
import PlatformLayout from "../../layouts/PlatformLayout.astro";
import { mfaChallengePath, requiresMfaChallenge } from "../../lib/auth";
export const prerender = false;
if (!Astro.locals.user) return Astro.redirect(`/account/sign-in/?next=${encodeURIComponent(Astro.url.pathname)}`, 303);
if (requiresMfaChallenge(Astro.locals.assurance)) return Astro.redirect(mfaChallengePath(Astro.url.pathname), 303);
const user = Astro.locals.user;
const supabase = Astro.locals.supabase!;
const [profileResult, entitlementsResult, organizationsResult, sessionsResult, featureResult] = await Promise.all([
    supabase.from("profiles").select("display_name,handle,avatar_url,biography,locale").eq("user_id", user.id).maybeSingle(),
    supabase.from("marketplace_entitlements").select("id,product_id,organization_id,granted_at,marketplace_products(display_name,slug,publishers(slug))").is("revoked_at", null).order("granted_at", { ascending: false }).limit(12),
    supabase.from("organization_memberships").select("role,organizations(id,slug,display_name)").eq("user_id", user.id),
    supabase.from("oauth_device_sessions").select("id,client_type,device_name,created_at,last_used_at,revoked_at").eq("user_id", user.id).order("last_used_at", { ascending: false }).limit(20),
    supabase.from("platform_feature_flags").select("key,enabled").in("key", ["marketplace_enabled", "publisher_portal_enabled"]),
]);
const profile = profileResult.data;
const entitlements = entitlementsResult.data ?? [];
const organizations = organizationsResult.data ?? [];
const sessions = sessionsResult.data ?? [];
const organizationCreationEnabled = (featureResult.data ?? []).some((flag) => flag.enabled === true);
const identities = user.identities ?? [];
const hasGitHub = identities.some((identity) => identity.provider === "github");
---
<PlatformLayout title="Account" description="Manage your Kéire profile, asset library, organizations, and connected sessions." robots="noindex">
    <section class="platform-section"><div class="platform-shell dashboard-grid">
        <nav class="dashboard-nav" aria-label="Account"><a href="/account/" aria-current="page">Overview</a><a href="#library">My assets</a><a href="#organizations">Organizations</a><a href="#security">Security</a><a href="/account/mfa/">Multi-factor authentication</a><a href="/account/data/">Data and privacy</a><form method="post" action="/account/session/delete/"><button class="button button--quiet" type="submit">Sign out</button></form></nav>
        <div><p class="eyebrow">Account overview</p><h1>{profile?.display_name ?? user.email ?? "Kéire developer"}</h1><p class="lead">{profile?.biography ?? "Your identity is shared across Kéire services; each browser and Hub session remains independently revocable."}</p>
            <section id="library"><h2>My assets</h2>{entitlements.length ? <table class="data-table"><thead><tr><th>Asset</th><th>Owner</th><th>Claimed</th></tr></thead><tbody>{entitlements.map((item: any) => <tr><td>{item.marketplace_products?.display_name ?? item.product_id}</td><td>{item.organization_id ? "Organization" : "Personal"}</td><td>{new Date(item.granted_at).toLocaleDateString()}</td></tr>)}</tbody></table> : <div class="empty-state"><h3>No claimed assets yet.</h3><p>Free marketplace assets you claim personally or for an organization appear here and in Hub.</p><a class="button button--secondary" href="/marketplace/">Browse Marketplace</a></div>}</section>
            <section id="organizations" class="platform-section"><h2>Organizations</h2>{organizations.length ? <table class="data-table"><thead><tr><th>Organization</th><th>Role</th></tr></thead><tbody>{organizations.map((membership: any) => <tr><td>{membership.organizations?.display_name}</td><td>{membership.role}</td></tr>)}</tbody></table> : <p class="notice-panel">You do not belong to an organization yet.</p>}{organizationCreationEnabled && <form class="form-stack notice-panel" data-organization-form><h3>Create an organization</h3><p>Organizations own shared marketplace entitlements and publisher identities.</p><label class="field"><span>Display name</span><input name="displayName" minlength="1" maxlength="96" required autocomplete="organization" /></label><label class="field"><span>URL slug</span><input name="slug" minlength="3" maxlength="63" pattern="[a-z0-9][a-z0-9-]{2,62}" required autocomplete="off" /></label><button class="button button--secondary" type="submit">Create organization</button><p class="form-message" role="status" aria-live="polite"></p></form>}</section>
            <section id="security"><h2>Security</h2><div class="notice-panel"><strong>Authenticator assurance: {Astro.locals.assurance.currentLevel ?? "unavailable"}</strong><p>Publishers, moderators, and administrators must use AAL2. Accounts with an enrolled factor are challenged before sensitive website operations.</p><p class="fine-print">Account ID <code>{user.id}</code></p><div class="actions"><a class="button button--secondary" href="/account/mfa/">Manage MFA</a>{!hasGitHub && <a class="button button--quiet" href="/account/github/?next=/account/">Link GitHub identity</a>}</div></div><h3>Connected identities</h3><ul>{identities.map((identity) => <li><strong>{identity.provider}</strong> <span class="fine-print">{identity.identity_data?.email ?? "Verified identity"}</span></li>)}</ul><h3>Connected devices</h3>{sessions.length ? <table class="data-table"><thead><tr><th>Device</th><th>Client</th><th>Last used</th><th>Status</th></tr></thead><tbody>{sessions.map((session: any) => <tr><td>{session.device_name}</td><td>{session.client_type}</td><td>{new Date(session.last_used_at).toLocaleString()}</td><td><span class={`status-badge ${session.revoked_at ? "" : "status-badge--ready"}`}>{session.revoked_at ? "Revoked" : "Active"}</span></td></tr>)}</tbody></table> : <p class="notice-panel">No registered Hub OAuth sessions. Browser sign-in remains active independently.</p>}</section>
        </div>
    </div></section>
</PlatformLayout>
<script>
    const organizationForm = document.querySelector<HTMLFormElement>("[data-organization-form]");
    organizationForm?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const message = organizationForm.querySelector<HTMLElement>(".form-message");
        const submit = organizationForm.querySelector<HTMLButtonElement>("button[type=submit]");
        const values = new FormData(organizationForm);
        if (message) { message.textContent = "Creating organization…"; message.dataset.kind = ""; }
        if (submit) submit.disabled = true;
        try {
            const response = await fetch("/marketplace/v1/organizations/", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ displayName: values.get("displayName"), slug: values.get("slug") }),
            });
            const result = await response.json();
            if (!response.ok) throw new Error(result.error?.message ?? "The organization could not be created.");
            if (message) { message.textContent = "Organization created. Refreshing…"; message.dataset.kind = "success"; }
            window.location.reload();
        } catch (error) {
            if (message) { message.textContent = error instanceof Error ? error.message : "The organization could not be created."; message.dataset.kind = "error"; }
            if (submit) submit.disabled = false;
        }
    });
</script>
