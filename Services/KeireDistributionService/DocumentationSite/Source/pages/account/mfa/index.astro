---
import PlatformLayout from "../../../layouts/PlatformLayout.astro";
export const prerender = false;
const localView = Astro.locals.localAccountView;
if (!Astro.locals.user && !localView) return Astro.redirect("/account/sign-in/?next=/account/mfa/", 303);
const result = localView ? { data: { all: localView.authenticatorFactors } }
    : await Astro.locals.supabase!.auth.mfa.listFactors();
const factors = result.data?.all ?? [];
const verified = factors.filter((factor) => factor.status === "verified");
---
<PlatformLayout title="Multi-factor authentication" description="Protect your Kéire account with an authenticator app." robots="noindex">
    <section class="platform-shell account-shell">
        <div class="account-shell__intro">
            <p class="eyebrow">Account security</p>
            <h1 class="display-title">Add another layer<br /><span>of protection.</span></h1>
            <p class="lead">Authenticator-app verification is required for publishers, moderators, and administrators. It is strongly recommended for every Kéire account.</p>
        </div>
        <div class="auth-card auth-card--security">
            <div class="auth-card__heading">
                <div>
                    <p class="auth-card__kicker">Current browser session</p>
                    <h2>Authenticator factors</h2>
                </div>
                <span class={`status-badge ${Astro.locals.assurance.currentLevel === "aal2" ? "status-badge--ready" : ""}`}>{Astro.locals.assurance.currentLevel ?? "AAL unavailable"}</span>
            </div>
            {verified.length ? <div class="factor-list" role="list" aria-label="Verified authenticators">
                {verified.map((factor) => <article class="factor-list__item" role="listitem">
                    <div>
                        <strong>{factor.friendly_name ?? "Authenticator app"}</strong>
                        <span class="factor-list__status"><i aria-hidden="true"></i>Verified</span>
                    </div>
                    <button class="button button--quiet button--small" type="button" data-remove-factor={factor.id}>Remove</button>
                </article>)}
                {Astro.locals.assurance.currentLevel !== "aal2" && <a class="button button--secondary" href="/account/mfa/challenge/?next=/account/mfa/">Verify this session</a>}
            </div> : <p class="notice-panel">No verified authenticator is enrolled.</p>}
            {factors.filter((factor) => factor.status === "unverified").map((factor) => <div class="notice-panel">
                <p>{factor.friendly_name ?? "Authenticator"}: unfinished setup. Cancel it to start again.</p>
                <button class="button button--quiet" type="button" data-remove-factor={factor.id}>Cancel unfinished setup</button>
            </div>)}
            {localView && <label class="field"><span>Current password</span>
                <input type="password" autocomplete="current-password" data-enrollment-password required />
            </label>}
            <div class="actions auth-card__actions">
                <button class="button" type="button" data-start-enrollment>Add authenticator app</button>
                <a class="button button--quiet" href="/account/">Back to account</a>
            </div>
            <section class="enrollment-panel" data-enrollment hidden>
                <h3>Scan the QR code</h3>
                <p>Use any standards-compatible authenticator app, then enter its current six-digit code.</p>
                <img class="mfa-qr" data-mfa-qr width="220" height="220" alt="Authenticator enrollment QR code" />
                <p class="fine-print">Manual setup secret</p>
                <code class="secret-value" data-mfa-secret></code>
                <form class="form-stack" data-verify-enrollment>
                    <input type="hidden" name="factorId" />
                    <label class="field"><span>Verification code</span><input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required /></label>
                    <div class="actions"><button class="button" type="submit">Verify and enable</button><button class="button button--quiet" type="button" data-cancel-enrollment>Cancel</button></div>
                </form>
            </section>
            <p class="form-message" aria-live="polite" data-mfa-message></p>
        </div>
    </section>
</PlatformLayout>
<script>
    const message = document.querySelector<HTMLElement>("[data-mfa-message]");
    const enrollment = document.querySelector<HTMLElement>("[data-enrollment]");
    const password = document.querySelector<HTMLInputElement>("[data-enrollment-password]");
    const factor = document.querySelector<HTMLInputElement>('[data-verify-enrollment] input[name="factorId"]');
    let busy = false;

    function showMessage(text: string, kind = "") {
        if (message) {
            message.textContent = text;
            message.dataset.kind = kind;
        }
    }

    async function submit(path: string, body: object, action: (data: any) => void) {
        if (busy) {
            return;
        }
        busy = true;
        showMessage("Working…");
        try {
            const response = await fetch(path, {
                method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body),
                credentials: "same-origin", cache: "no-store", signal: AbortSignal.timeout(15000),
            });
            const result = await response.json();
            if (!response.ok) {
                showMessage(result.error?.message ?? "The change could not be completed.", "error");
                return;
            }
            action(result.data);
        } catch {
            showMessage("The result could not be confirmed. Reload your security settings before trying again.", "error");
        } finally {
            busy = false;
        }
    }

    document.querySelector("[data-start-enrollment]")?.addEventListener("click", async () => {
        if (password && !password.reportValidity()) {
            return;
        }
        if (factor?.value) {
            showMessage("Finish or cancel the current setup before starting another.", "error");
            return;
        }
        await submit("/account/mfa/enroll/", { friendlyName: "Kéire authenticator", password: password?.value }, (data) => {
            if (password) {
                password.value = "";
            }
            if (enrollment) {
                enrollment.hidden = false;
            }
            const qr = document.querySelector<HTMLImageElement>("[data-mfa-qr]");
            const secret = document.querySelector<HTMLElement>("[data-mfa-secret]");
            if (qr) {
                qr.src = data.qrCode;
            }
            if (secret) {
                secret.textContent = data.secret;
            }
            if (factor) {
                factor.value = data.factorId;
            }
            const instructions = "Scan the code and enter the current six-digit token.";
            showMessage(password ? `${instructions} New setups expire after 15 minutes.` : instructions);
        });
    });

    document.querySelector("[data-verify-enrollment]")?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!(event.currentTarget instanceof HTMLFormElement)) {
            return;
        }
        const values = new FormData(event.currentTarget);
        await submit("/account/mfa/verify/", { factorId: values.get("factorId"), code: values.get("code") }, () => location.reload());
    });

    async function remove(factorId: string) {
        await submit("/account/mfa/remove/", { factorId }, (data) => {
            if (data.signedOut) {
                location.assign("/account/sign-in/");
                return;
            }
            location.reload();
        });
    }

    document.querySelector("[data-cancel-enrollment]")?.addEventListener("click", async () => {
        if (factor?.value) {
            await remove(factor.value);
        }
    });
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-remove-factor]")) {
        button.addEventListener("click", () => remove(button.dataset.removeFactor!));
    }
</script>
