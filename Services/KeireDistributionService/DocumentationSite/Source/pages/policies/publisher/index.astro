---
import PolicyPage from "../../../components/PolicyPage.astro";
export const prerender = true;
const sections = [
    { title: "Approval", paragraphs: ["Publishers apply through a reviewable workflow. Approval does not guarantee publication of any product or version. Staff approval and an offline marketplace signature are required for publication."] },
    { title: "Rights and provenance", paragraphs: ["Publishers must hold the rights required to distribute every included file and must disclose third-party material and its license. Secret keys, stolen content, malware, undeclared binaries, and misleading compatibility claims are prohibited."] },
    { title: "Executable content", paragraphs: ["Content and declared C# assemblies may be submitted. Native plugins remain prohibited for Kéire 0.4.4. Server validation never executes package code, analyzers, source generators, install scripts, native binaries, or arbitrary build hooks."] },
    { title: "Support and security", paragraphs: ["Publishers must maintain accurate release notes and compatibility, respond to security notices, and publish corrections as new immutable versions. A security-revoked version may be blocked immediately."] },
];
---
<PolicyPage title="Publisher terms" description="Draft requirements for approved Kéire Marketplace publishers and submitted packages." sections={sections} />
