---
import PolicyPage from "../../../components/PolicyPage.astro";
export const prerender = true;
const sections = [
    { title: "Free products in Kéire 0.4.0", paragraphs: ["All public offers retain a zero minor-unit price for Kéire 0.4.0. This release does not change the Marketplace protocol. Paid checkout, taxes, refunds, payouts, and payment providers remain disabled even though provider-neutral records reserve a future boundary."] },
    { title: "Entitlements", paragraphs: ["An accepted free claim creates an idempotent order and a perpetual personal or organization entitlement. Entitlement authorizes download; package hashes and signatures separately establish integrity."] },
    { title: "Validation and publication", paragraphs: ["A publisher uploads each version once to private immutable storage. Automated validation produces a signed, bounded evidence report for staff review; reviewers do not need possession of the publisher's archive. Approval queues metadata-only signature and publication processing. A published version is immutable, and corrections require a new version.", "Staff may request changes, reject or delist a product, suspend a publisher, or security-revoke a version after review. Security revocations override download access."] },
    { title: "Reviews and reports", paragraphs: ["Only entitled owners may publish one editable review per ownership target. Reviews, replies, listings, and packages can be reported and moderated under the acceptable-use policy."] },
];
---
<PolicyPage title="Marketplace terms" description="Draft ownership, entitlement, publication, moderation, and free-product terms for Kéire Marketplace." sections={sections} />
