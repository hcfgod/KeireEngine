---
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import SessionAwareAccountLink from "./SessionAwareAccountLink.astro";
---

<div class="keire-doc-mobile-account">
    <nav aria-label="Kéire platform"><a href="/roadmap/">Roadmap</a><a href="/changelog/">Changelog</a><a href="/marketplace/">Marketplace</a><a href="/downloads/">Downloads</a></nav>
    <SessionAwareAccountLink class="keire-doc-account" sessionKnown={false} />
</div>
<div class="mobile-preferences sl-flex">
    <div class="social-icons">
        <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
</div>

<style>
    @layer starlight.core {
        .keire-doc-mobile-account {
            padding-block: 0.8rem;
            border-top: 1px solid var(--sl-color-gray-6);
        }

        .keire-doc-mobile-account nav {
            display: flex;
            margin-bottom: 0.8rem;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .social-icons {
            display: flex;
            margin-inline-end: auto;
            padding-block: 1rem;
            align-items: center;
            gap: 1rem;
        }

        .social-icons:empty {
            display: none;
        }

        .mobile-preferences {
            padding: 0.5rem 0;
            border-top: 1px solid var(--sl-color-gray-6);
            justify-content: space-between;
            flex-wrap: wrap;
            column-gap: 1rem;
        }
    }
</style>
