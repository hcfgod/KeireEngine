<p class="form-message" role="status" aria-live="polite" data-local-recovery-message>Checking your recovery link…</p>
<form class="form-stack" data-local-recovery-form>
    <fieldset disabled>
        <label class="field" data-recovery-factor-field hidden>
            <span>Authenticator</span><select name="factorId"></select>
        </label>
        <label class="field" data-recovery-code-field hidden>
            <span>Six-digit authenticator code</span>
            <input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" />
        </label>
        <label class="field"><span>New password</span>
            <input name="password" type="password" autocomplete="new-password" minlength="10" maxlength="256" required />
        </label>
        <label class="field"><span>Confirm new password</span>
            <input name="confirmation" type="password" autocomplete="new-password" minlength="10" maxlength="256" required />
        </label>
        <p>Use at least 10 characters. The password must fit within 72 UTF-8 bytes; some characters use multiple bytes.</p>
        <button class="button" type="submit">Update password</button>
    </fieldset>
</form>
<p><a href="/account/recover/">Request a new recovery email</a></p>
<p><a href="/account/sign-in/">Return to sign in</a></p>

<script>
    const form = document.querySelector<HTMLFormElement>("[data-local-recovery-form]");
    const message = document.querySelector<HTMLElement>("[data-local-recovery-message]");
    if (form && message) {
        const fields = form.querySelector("fieldset")!;
        const factor = form.querySelector<HTMLSelectElement>("[name=factorId]")!;
        const code = form.querySelector<HTMLInputElement>("[name=code]")!;
        const password = form.querySelector<HTMLInputElement>("[name=password]")!;
        const confirmation = form.querySelector<HTMLInputElement>("[name=confirmation]")!;
        const showError = (text: string) => {
            message.dataset.kind = "error";
            message.textContent = text;
        };
        async function initialize() {
            const fragment = new URLSearchParams(location.hash.slice(1));
            const token = fragment.get("recovery");
            if (location.hash) {
                history.replaceState(null, "", location.pathname + location.search);
            }
            try {
                const response = await fetch(token ? "/account/recovery/session/" : "/account/recovery/status/", {
                    method: token ? "POST" : "GET",
                    headers: { "content-type": "application/json" },
                    body: token ? JSON.stringify({ token }) : undefined,
                    cache: "no-store", credentials: "same-origin", signal: AbortSignal.timeout(15000),
                });
                const result = await response.json();
                if (!response.ok) {
                    showError(result.error?.message ?? "The recovery link could not be checked. Request a new one.");
                    return;
                }
                for (const item of result.data.factors) {
                    const option = document.createElement("option");
                    option.value = item.id;
                    option.textContent = item.friendlyName;
                    factor.append(option);
                }
                const requiresCode = factor.options.length > 0;
                form.querySelector<HTMLElement>("[data-recovery-factor-field]")!.hidden = !requiresCode;
                form.querySelector<HTMLElement>("[data-recovery-code-field]")!.hidden = !requiresCode;
                code.required = requiresCode;
                fields.disabled = false;
                message.textContent = requiresCode ? "Verify your authenticator and choose a new password." : "Choose a new password.";
            } catch {
                showError("We could not check the recovery link. Reopen the email link and try again.");
            }
        }
        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            if (fields.disabled) return;
            if (password.value !== confirmation.value) {
                showError("The passwords do not match.");
                confirmation.focus();
                return;
            }
            if (new TextEncoder().encode(password.value).length > 72) {
                showError("The password exceeds 72 UTF-8 bytes. Choose a shorter password.");
                return;
            }
            fields.disabled = true;
            form.setAttribute("aria-busy", "true");
            let completed = false;
            try {
                const response = await fetch("/account/password/", {
                    method: "PATCH", headers: { "content-type": "application/json" },
                    body: JSON.stringify({ password: password.value, factorId: factor.value || null, code: code.value }),
                    cache: "no-store", credentials: "same-origin", signal: AbortSignal.timeout(15000),
                });
                const result = await response.json();
                if (!response.ok) {
                    showError(result.error?.message ?? "Password recovery could not be completed.");
                    return;
                }
                completed = true;
                form.reset();
                form.hidden = true;
                message.dataset.kind = "success";
                message.textContent = "Password updated. Your previous browser sessions are signed out. Sign in with your new password.";
            } catch {
                showError("The result could not be confirmed. Try signing in with the new password before requesting another reset.");
            } finally {
                form.removeAttribute("aria-busy");
                if (!completed) fields.disabled = false;
            }
        });
        void initialize();
    }
</script>

<style>
    [hidden] { display: none !important; }
    fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 1rem; min-width: 0; }
</style>
